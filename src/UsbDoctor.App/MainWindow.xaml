<Window x:Class="UsbDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsbDoctor.App"
        Title="USB Doctor" Height="720" Width="1080">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="12">

        <!-- Drive selection -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="320" VerticalAlignment="Center"
                      ItemsSource="{Binding Drives}"
                      SelectedItem="{Binding SelectedDrive}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Root, Mode=OneWay}" />
                            <Run Text="{Binding Label, Mode=OneWay}" />
                            <Run Text="{Binding FileSystem, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh" Command="{Binding RefreshDrivesCommand}" Margin="8,0,8,0" />
            <Button Content="Scan" Command="{Binding ScanCommand}" />
        </StackPanel>

        <!-- Destinations and safety switches -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0" Content="Rescue first to:"
                      IsChecked="{Binding RescueFirst}" VerticalAlignment="Center" Margin="0,0,8,4" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RescueDestination}" Margin="0,0,8,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quarantine to:"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QuarantineRoot}" Margin="0,0,8,0" />

            <CheckBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                      Content="Dry run (make no changes)"
                      IsChecked="{Binding DryRun}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>

        <!-- Apply -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Apply selected actions" Command="{Binding ApplyCommand}" />
            <TextBlock VerticalAlignment="Center" Foreground="#B00"
                       Text="Actions marked ! are irreversible and start unticked." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Findings -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Findings" Style="{StaticResource Heading}" />
                <ListBox ItemsSource="{Binding Findings}" FontFamily="Consolas" FontSize="12"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <!-- Proposed actions -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Proposed actions" Style="{StaticResource Heading}" />
                <ListBox ItemsSource="{Binding Actions}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                          Margin="0,2,8,0" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                        <TextBlock Text=" - " />
                                        <TextBlock Text="{Binding Severity}" Foreground="#666" />
                                        <TextBlock Text="  !" Foreground="#B00" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Foreground="#333" MaxWidth="460" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
