<Window x:Class="UsbDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsbDoctor.App"
        Title="USB Doctor" Height="760" Width="1120">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="12">

        <!-- Drive selection -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="300" VerticalAlignment="Center"
                      ItemsSource="{Binding Drives}"
                      SelectedItem="{Binding SelectedDrive}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Root, Mode=OneWay}" />
                            <Run Text="{Binding Label, Mode=OneWay}" />
                            <Run Text="{Binding FileSystem, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh" Command="{Binding RefreshDrivesCommand}" Margin="8,0,8,0" />
            <Button Content="Scan" Command="{Binding ScanCommand}" />
            <CheckBox Content="Scan automatically when a USB is plugged in"
                      IsChecked="{Binding AutoScanOnInsert}"
                      VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>

        <TabControl>

            <!-- ============ Repair ============ -->
            <TabItem Header="Repair">
                <DockPanel Margin="8">

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Content="Rescue first to:"
                                  IsChecked="{Binding RescueFirst}"
                                  VerticalAlignment="Center" Margin="0,0,8,4" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding RescueDestination}" Margin="0,0,8,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Quarantine to:"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding QuarantineRoot}" Margin="0,0,8,0" />

                        <CheckBox Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                  Content="Dry run (make no changes)"
                                  IsChecked="{Binding DryRun}"
                                  VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Apply selected actions" Command="{Binding ApplyCommand}" />
                        <TextBlock VerticalAlignment="Center" Foreground="#B00"
                                   Text="Actions marked ! are irreversible and start unticked." />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Findings"
                                       Style="{StaticResource Heading}" />
                            <ListBox ItemsSource="{Binding Findings}" FontFamily="Consolas" FontSize="12"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Proposed actions"
                                       Style="{StaticResource Heading}" />
                            <ListBox ItemsSource="{Binding Actions}" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                                    <TextBlock Text=" - " />
                                                    <TextBlock Text="{Binding Severity}" Foreground="#666" />
                                                    <TextBlock Text="  !" Foreground="#B00" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDestructive}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="#333" MaxWidth="470" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ Deleted files ============ -->
            <TabItem Header="Deleted files">
                <DockPanel Margin="8">

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Read deleted entries" Command="{Binding ReadDeletedCommand}" />
                        <TextBlock Text="Recover to:" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <TextBox Text="{Binding RecoverTo}" Width="420" VerticalAlignment="Center" />
                        <Button Content="Recover ticked" Command="{Binding RecoverDeletedCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#FFF8E1" Padding="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding RawStatus}" TextWrapping="Wrap" />
                    </Border>

                    <ListView ItemsSource="{Binding DeletedEntries}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanRecover}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Path" Width="440"
                                                DisplayMemberBinding="{Binding Path}" />
                                <GridViewColumn Header="Size" Width="90"
                                                DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Verdict" Width="110"
                                                DisplayMemberBinding="{Binding Confidence}" />
                                <GridViewColumn Header="Why" Width="380"
                                                DisplayMemberBinding="{Binding Summary}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
