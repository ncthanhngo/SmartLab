<Window x:Class="UsbDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:UsbDoctor.App"
        Title="USB Doctor" Height="720" Width="1140"
        MinHeight="560" MinWidth="920"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <!--
        WindowChrome rather than AllowsTransparency: the caption is ours to draw,
        but Windows keeps resize, snap layouts and its own corner rounding. A
        transparent window would hand all three back to us to reimplement badly.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="{StaticResource ShellTopColor}" Offset="0" />
            <GradientStop Color="{StaticResource ShellBottomColor}" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Grid Grid.Row="0">
            <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Left"
                     Margin="18,0,0,0" VerticalAlignment="Center" />

            <TextBlock Text="USB Doctor" VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimiseButton" Style="{StaticResource WindowButton}"
                        Content="&#xE921;" ToolTip="Minimise" Click="OnMinimise" />
                <Button x:Name="MaximiseButton" Style="{StaticResource WindowButton}"
                        Content="&#xE922;" ToolTip="Maximise" Click="OnMaximise" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}"
                        Content="&#xE8BB;" ToolTip="Close to tray" Click="OnCloseClicked" />
            </StackPanel>
        </Grid>

        <!-- ==================== body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== sidebar ===== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource SidebarHairlineBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- brand block: gives the column a head instead of starting mid-air -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrandBlockBrush}"
                            Padding="16,14" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Control Style="{StaticResource LogoMark}" VerticalAlignment="Center" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="USB Doctor" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="rescue &amp; maintenance"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                        <Border Height="1" Background="{StaticResource SidebarHairlineBrush}"
                                Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="{Binding Source={x:Static local:MainViewModel.AppVersion},
                                                  StringFormat='Version {0}'}" />
                        <TextBlock Foreground="{StaticResource AccentAboutBrush}" FontSize="11.5"
                                   Text="{Binding Source={x:Static local:MainViewModel.AppAuthor}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="14,8,14,12">
                        <TextBlock Text="DRIVE" Style="{StaticResource CaptionText}"
                                   Margin="4,0,0,6" FontWeight="SemiBold" />
                        <ComboBox Style="{StaticResource DriveCombo}"
                                  ItemsSource="{Binding Drives}"
                                  SelectedItem="{Binding SelectedDrive}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding Root, Mode=OneWay}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionText}">
                                            <Run Text="{Binding FileSystem, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Refresh drives" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshDrivesCommand}"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    </StackPanel>

                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}" Margin="8,0,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Row fill, rail and glyph colour all come from the
                                     section's own accent, so each entry is identifiable
                                     by colour before the label is read. -->
                                <Border x:Name="Row" CornerRadius="10" Padding="10,9"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="Rail" Grid.Column="0" Width="3"
                                                CornerRadius="2" Opacity="0"
                                                Background="{Binding Accent}"
                                                Margin="0,1,9,1" />

                                        <Border x:Name="Plate" Grid.Column="1"
                                                Width="30" Height="30" CornerRadius="8"
                                                Background="{Binding IconPlate}"
                                                Margin="0,0,11,0">
                                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{Binding Accent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="Title" Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Row" Property="Background" Value="#1A2340" />
                                        <Setter TargetName="Title" Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                    </DataTrigger>

                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{Binding SelectedFill}" />
                                        <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                        <Setter TargetName="Plate" Property="Background"
                                                Value="{Binding Accent}" />

                                        <!-- The plate is now saturated, so the glyph has to
                                             flip dark or it disappears into it. -->
                                        <Setter TargetName="Glyph" Property="Foreground"
                                                Value="{StaticResource OnAccentBrush}" />
                                        <Setter TargetName="Title" Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== main panel ===== -->
            <Grid Grid.Column="1" Margin="22,14,22,8">

                <!-- ===== Repair ===== -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="repair">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <!-- headline; swaps to a live scan readout while work is in flight -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20"
                            Margin="0,0,0,14">
                        <Grid>
                            <!-- ===== scanning readout ===== -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Scanning" Style="{StaticResource DisplayText}" />

                                    <!-- Trimmed at the head, not the tail: when a path is too
                                         long the interesting part is the file at the end. -->
                                    <TextBlock Text="{Binding ScanningPath}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" Margin="0,6,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextTrimming="WordEllipsis"
                                               FlowDirection="RightToLeft" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ScanDirectories, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="folders" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Margin="18,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ScanEntries, StringFormat={}{0:N0}}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="entries" Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- ===== idle / result readout ===== -->
                            <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tone dot: colour carries the verdict, the number carries the detail. -->
                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,14,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadlineTone}" Value="good">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeadlineTone}" Value="warning">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeadlineTone}" Value="danger">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}" />
                                <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="18,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ThreatCount}" FontSize="22"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="threats" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="18,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding AnomalyCount}" FontSize="22"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="anomalies" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ScanCommand}" Margin="14,0,0,0" />
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- destinations + dry run -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" Style="{StaticResource ToggleCheck}"
                                      Content="Rescue first to" IsChecked="{Binding RescueFirst}"
                                      Margin="0,0,12,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PathBox}"
                                     Text="{Binding RescueDestination}" Margin="0,0,16,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quarantine to"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PathBox}"
                                     Text="{Binding QuarantineRoot}" Margin="0,0,16,0" />

                            <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                    Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource ControlRadius}" Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                              IsChecked="{Binding DryRun}" FontWeight="SemiBold" />
                                    <TextBlock Text="Nothing is written" Margin="0,4,0,0"
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- apply -->
                    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply selected actions" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyCommand}" />
                            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Text="Irreversible actions are marked and start unticked." />
                        </StackPanel>
                    </Border>

                    <!-- findings + actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Findings"
                                           Style="{StaticResource SectionTitle}" />
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Findings}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11.5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Proposed actions"
                                           Style="{StaticResource SectionTitle}" />
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Actions}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                    CornerRadius="{StaticResource ControlRadius}"
                                                    Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Top" Margin="0,2,11,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Kind}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                                                    CornerRadius="4" Padding="6,1"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Severity}"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="irreversible" FontSize="10.5"
                                                                       Margin="8,0,0,0" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource DangerBrush}"
                                                                       Visibility="{Binding IsDestructive,
                                                                           Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ===== Deleted files ===== -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="deleted">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Reads the device directly, below the mounted filesystem."
                                       Style="{StaticResource BodyText}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Read deleted entries" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ReadDeletedCommand}" />
                                <TextBlock Text="Recover to" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="16,0,10,0" />
                                <TextBox Style="{StaticResource PathBox}" Text="{Binding RecoverTo}"
                                         Width="360" />
                                <Button Content="Recover ticked" Style="{StaticResource GhostButton}"
                                        Command="{Binding RecoverDeletedCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                            Background="{StaticResource SurfaceSunkenBrush}" Padding="14,10"
                            Margin="0,14,0,0">
                        <TextBlock Text="{Binding RawStatus}" Style="{StaticResource BodyText}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="8">
                        <ListView ItemsSource="{Binding DeletedEntries}" Background="Transparent"
                                  BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="Padding" Value="4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="42">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource RowCheck}"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding CanRecover}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Path" Width="380"
                                                    DisplayMemberBinding="{Binding Path}" />
                                    <GridViewColumn Header="Size" Width="90"
                                                    DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="Verdict" Width="110"
                                                    DisplayMemberBinding="{Binding Confidence}" />
                                    <GridViewColumn Header="Why" Width="340"
                                                    DisplayMemberBinding="{Binding Summary}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>

                <!-- ===== Settings ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Watching" Style="{StaticResource SectionTitle}" />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Scan automatically when a USB is plugged in"
                                      IsChecked="{Binding AutoScanOnInsert}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="The drive that started this project had carried its worm for six days before anyone looked." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Keep watching in the tray when the window is closed"
                                      IsChecked="{Binding KeepWatchingInTray}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="Watching runs on the window's message loop, so closing would otherwise stop it. Exit from the tray menu." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                       Text="Registers for this user only, starting in the tray. Never machine-wide." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Cleanup ===== -->
                <DockPanel DataContext="{Binding Cleanup}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SelectedSection.Key,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="cleanup">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <!-- headline: reclaimable total and the two actions -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0">
                                <TextBlock Text="{Binding TotalText}" FontSize="34" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="reclaimable" Style="{StaticResource CaptionText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Disk cleanup" Style="{StaticResource DisplayText}"
                                           FontSize="20" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                           Text="Only the ticked categories are counted, and only ticked categories are cleaned." />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                          IsChecked="{Binding DryRun}" FontWeight="SemiBold"
                                          Margin="0,0,16,0" />
                                <Button Content="Analyse" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AnalyseCommand}" />
                                <Button Content="Clean" Style="{StaticResource GhostButton}"
                                        Command="{Binding CleanCommand}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                            Background="{StaticResource SurfaceSunkenBrush}" Padding="14,10"
                            Margin="0,14,0,0">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="What to clean"
                                           Style="{StaticResource SectionTitle}" />
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Categories}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                    CornerRadius="{StaticResource ControlRadius}"
                                                    Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Top" Margin="0,2,11,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                    Visibility="{Binding NeedsElevation,
                                                                        Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="admin" FontSize="10"
                                                                           Foreground="{StaticResource InfoBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Detail}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,3,0,0" />

                                                        <TextBlock Text="{Binding Caution}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource WarningBrush}"
                                                                   Visibility="{Binding HasCaution,
                                                                       Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="12.5"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Text="{Binding Files, StringFormat={}{0:N0} files}"
                                                                   Visibility="{Binding Measured,
                                                                       Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Log"
                                           Style="{StaticResource SectionTitle}" />
                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Log}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ===== Uninstall ===== -->
                <DockPanel DataContext="{Binding Uninstall}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SelectedSection.Key,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="uninstall">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                            Background="{StaticResource SurfaceSunkenBrush}" Padding="14,10"
                            Margin="0,14,0,0">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- remove USB Doctor itself -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Remove USB Doctor"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                                               Text="Everything this app has written. Your rescued data and quarantined samples are listed but start unticked - they may be the only copy left." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Find traces" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ScanSelfCommand}" />
                                        <Button Content="Remove ticked" Style="{StaticResource GhostButton}"
                                                Command="{Binding RemoveSelfCommand}" Margin="10,0,0,0" />
                                        <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                                  IsChecked="{Binding DryRun}" Margin="14,0,0,0"
                                                  FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding SelfTraces}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                    CornerRadius="{StaticResource ControlRadius}"
                                                    Padding="11,9" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Top" Margin="0,2,11,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="your data" FontSize="10.5"
                                                                       Margin="8,0,0,0" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       Visibility="{Binding IsUserData,
                                                                           Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Location}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                               Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- remove other programs -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Installed programs"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                                               Text="Runs the vendor's own uninstaller, then reports what it left behind. Windows components and updates are not listed." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="List programs" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ScanProgramsCommand}" />
                                        <Button Content="Uninstall selected" Style="{StaticResource GhostButton}"
                                                Command="{Binding UninstallProgramCommand}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <TextBlock Text="Leftovers" Style="{StaticResource SectionTitle}"
                                                   Margin="0,0,0,6" />
                                        <ListBox Style="{StaticResource PlainList}"
                                                 ItemsSource="{Binding Leftovers}" MaxHeight="150">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <CheckBox Style="{StaticResource RowCheck}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding Location}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="380" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="Clean ticked leftovers"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding CleanLeftoversCommand}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <ListView ItemsSource="{Binding Programs}"
                                              SelectedItem="{Binding SelectedProgram}"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="{StaticResource TextSecondaryBrush}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Program" Width="230"
                                                                DisplayMemberBinding="{Binding DisplayName}" />
                                                <GridViewColumn Header="Version" Width="90"
                                                                DisplayMemberBinding="{Binding Version}" />
                                                <GridViewColumn Header="Publisher" Width="150"
                                                                DisplayMemberBinding="{Binding Publisher}" />
                                                <GridViewColumn Header="Size" Width="70"
                                                                DisplayMemberBinding="{Binding SizeText}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ===== About ===== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="about">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource Card}" Padding="34"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="440">
                        <StackPanel HorizontalAlignment="Center">
                            <Control Style="{StaticResource LogoMark}" HorizontalAlignment="Center" />

                            <TextBlock Text="USB Doctor" Style="{StaticResource DisplayText}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" />

                            <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Center"
                                     Margin="0,8,0,0" />

                            <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                                       Margin="0,18,0,0" MaxWidth="380"
                                       Text="Triage and recovery for USB drives whose files have disappeared. Built from a real worm infection: the data was not hidden, it was moved into a folder named with a single invisible character." />

                            <Border Background="{StaticResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="16,12" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="{Binding Source={x:Static local:MainViewModel.AppVersion},
                                                              StringFormat='Version {0}'}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontSize="12.5"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding Source={x:Static local:MainViewModel.AppAuthor}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== status ==================== -->
        <StackPanel Grid.Row="2">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource SurfaceSunkenBrush}" Padding="18,9"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
