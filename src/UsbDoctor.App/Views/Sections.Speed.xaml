<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:UsbDoctor.App.Controls">

    <!-- ================= Startup ================= -->

    <DataTemplate x:Key="section-optimize">
        <DockPanel DataContext="{Binding DataContext.Optimization,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Grid DockPanel.Dock="Bottom" Height="215" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedItems.View}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="InsetGroups" />
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanChange}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Command}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding OriginText}"
                                                       FontSize="10" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Turned off by this app"
                                   Style="{StaticResource SectionTitle}" />
                        <Button DockPanel.Dock="Bottom" Content="Put them all back"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding RestoreAllCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Disabled}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="0,0,0,3"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="12" Percent="{Binding GaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentOptimizeBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ItemCount}" FontSize="32"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="run at logon" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="490" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" Padding="32,9" />
                        <Button Content="Turn ticked off" Style="{StaticResource GhostButton}"
                                Command="{Binding DisableTickedCommand}" Margin="10,0,0,0" />
                        <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                  IsChecked="{Binding DryRun}" Margin="16,0,0,0"
                                  FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Repair OS ================= -->

    <DataTemplate x:Key="section-maintenance">
        <DockPanel DataContext="{Binding DataContext.Maintenance,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Grid DockPanel.Dock="Bottom" Height="235" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Windows' own tools"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Commands}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            Padding="11,9" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding NeedsElevation,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="admin" FontSize="10"
                                                                   Foreground="{DynamicResource InfoBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding CommandLine}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="Run" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Outcome}" FontSize="10"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Output, unedited"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Transcript}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="11" Percent="{Binding GaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentMaintenanceBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CompletedCount}" FontSize="30"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="tools run" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="490" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
