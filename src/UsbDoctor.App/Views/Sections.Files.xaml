<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:UsbDoctor.App.Controls">

    <!-- ================= Space Lens ================= -->

    <DataTemplate x:Key="section-spacelens">
        <DockPanel DataContext="{Binding DataContext.SpaceLens,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding RootFolder}" Width="380" />
                <Button Content="Measure" Style="{StaticResource PrimaryButton}"
                        Command="{Binding MeasureCommand}" Margin="10,0,0,0" />
                <Button Content="Up" Style="{StaticResource GhostButton}"
                        Command="{Binding GoUpCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <!-- The map takes the room a list would, below the stage. Bigger than the
                 other sections' lists because a treemap of thirty folders in 175px
                 is a colour bar, not a map. -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="6"
                    Height="300" Margin="0,14,0,0">
                <ctl:Treemap ItemsSource="{Binding Tiles}"
                             TileCommand="{Binding DescendCommand}"
                             HairlineBrush="{DynamicResource SurfaceBrush}"
                             LabelBrush="White" />
            </Border>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="132" Height="132" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="11" Percent="{Binding GaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentSpaceLensBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalText}" FontSize="24"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="in view" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="19" HorizontalAlignment="Center" Margin="0,12,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="470" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Large & Old Files ================= -->

    <DataTemplate x:Key="section-large">
        <DockPanel DataContext="{Binding DataContext.LargeFiles,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding RootFolder}" Width="300" />
                <TextBlock Text="BIGGER THAN" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding MinimumMegabytes}" Width="60" />
                <TextBlock Text="MB" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Text="OLDER THAN" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding MinimumMonths}" Width="46" />
                <TextBlock Text="months" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14"
                    Height="175" Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GroupedFiles.View}">
                        <ItemsControl.GroupStyle>
                            <StaticResource ResourceKey="InsetGroups" />
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" FontSize="10"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding AgeText}" FontSize="10.5"
                                                   Margin="12,0,0,0" MinWidth="60" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />

                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                                                   Margin="12,0,0,0" MinWidth="66" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="160" Height="160" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="12" Percent="{Binding GaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentLargeBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FileCount}" FontSize="34"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="files" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="21" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="470" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" Padding="34,10" />
                        <Button Content="Send ticked to Recycle Bin" Style="{StaticResource GhostButton}"
                                Command="{Binding RecycleTickedCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Shredder ================= -->

    <DataTemplate x:Key="section-shredder">
        <DockPanel DataContext="{Binding DataContext.Shredder,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding Folder}" Width="380" />
                <Button Content="Queue its files" Style="{StaticResource GhostButton}"
                        Command="{Binding AddFolderCommand}" Margin="10,0,0,0" />
                <TextBlock Text="PASSES" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="18,0,8,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding Passes}" Width="44" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14"
                    Height="175" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Queued"
                               Style="{StaticResource SectionTitle}" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Targets}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontSize="10.5"
                                               Margin="12,0,0,0" MinWidth="80"
                                               Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10.5"
                                               Margin="12,0,0,0" MinWidth="60" TextAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="160" Height="160" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="12" Percent="{Binding GaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentShredderBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FileCount}" FontSize="34"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="queued" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="21" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="500" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <Button Content="Shred" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ShredCommand}" Padding="34,10" />
                        <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                  IsChecked="{Binding DryRun}" Margin="16,0,0,0"
                                  FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Deleted files ================= -->

    <DataTemplate x:Key="section-deleted">
        <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

            <!-- drive and destination strip: the settings the stage's two
                 verbs act on, kept off the stage itself -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="DRIVE" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <ComboBox Style="{StaticResource DriveCombo}" Width="230"
                          ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding Root, Mode=OneWay}" />
                                <Run Text="{Binding Label, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="RECOVER TO" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="18,0,10,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding RecoverTo}" Width="330" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding RawStatus}" Style="{StaticResource BodyText}" />
            </Border>

            <!-- Grouped by verdict rather than listed flat. The verdict is what
                 decides whether carving is worth attempting, so it is the axis
                 the operator triages on - a flat table makes them read every
                 row to find the recoverable ones.

                 Fixed, so the stage above absorbs the extra on a taller window
                 rather than the list growing away from its dial. -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14"
                    Height="175" Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GroupedDeletedEntries.View}">
                        <ItemsControl.GroupStyle>
                            <StaticResource ResourceKey="InsetGroups" />
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanRecover}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Path}" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   FontSize="11" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="176" Height="176" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="13" Percent="{Binding DeletedGaugePercent}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}"
                                         ValueBrush="{DynamicResource AccentDeletedBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RecoverableCount}" FontSize="40"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="recoverable" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DeletedHeadline}" Style="{StaticResource DisplayText}"
                               FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding DeletedHeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="430" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Button Content="Read deleted entries" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ReadDeletedCommand}" Padding="30,10" />
                        <Button Content="Recover ticked" Style="{StaticResource GhostButton}"
                                Command="{Binding RecoverDeletedCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
