<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark surface stack. Depth comes from three closely spaced greys rather than
        from borders or shadows, which is what keeps a dark interface from looking
        like a stack of outlined boxes.
    -->
    <!--
        Blue-black rather than neutral black. A trace of hue in the darkest tones is
        what stops a dark interface reading as switched off, and it gives the
        coloured accents something to sit against instead of a void.
    -->
    <Color x:Key="ShellTopColor">#141B29</Color>
    <Color x:Key="ShellBottomColor">#0B0F18</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#181F2C" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F2735" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#10161F" />

    <!-- The sidebar is its own gradient so it reads as a distinct surface without
         needing a border to say so. -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#223058" Offset="0" />
        <GradientStop Color="#18213A" Offset="0.45" />
        <GradientStop Color="#101728" Offset="1" />
    </LinearGradientBrush>

    <!-- Sits behind the brand block at the top of the sidebar. -->
    <LinearGradientBrush x:Key="BrandBlockBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3D6E" Offset="0" />
        <GradientStop Color="#1E2A4C" Offset="1" />
    </LinearGradientBrush>

    <!-- Per-section accents. Each nav row carries its own so the sidebar has focal
         points instead of six identical grey lines. -->
    <Color x:Key="AccentRepairColor">#2BD673</Color>
    <Color x:Key="AccentDeletedColor">#5AA9FF</Color>
    <Color x:Key="AccentCleanupColor">#F5B93B</Color>
    <Color x:Key="AccentUninstallColor">#FF6B8A</Color>
    <Color x:Key="AccentSettingsColor">#A78BFA</Color>
    <Color x:Key="AccentAboutColor">#4DD4C4</Color>

    <SolidColorBrush x:Key="AccentAboutBrush" Color="#4DD4C4" />
    <SolidColorBrush x:Key="AccentDeletedBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="AccentCleanupBrush" Color="#F5B93B" />
    <SolidColorBrush x:Key="AccentUninstallBrush" Color="#FF6B8A" />

    <!-- The unfilled part of a gauge ring. Bright enough to show the ring's shape
         on a dark card, dim enough that an empty gauge does not read as a value. -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#232D3E" />

    <!-- Sits on a saturated accent plate, so it has to be dark rather than light. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1018" />

    <SolidColorBrush x:Key="HairlineBrush" Color="#28323F" />
    <SolidColorBrush x:Key="SidebarHairlineBrush" Color="#2A3552" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EEF4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B98A8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F6B7A" />

    <!-- Accent taken from the EVSELab mark, so the brand reads as the app's. -->
    <Color x:Key="AccentColor">#2BD673</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2BD673" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#22B25E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B3A29" />

    <Color x:Key="BoltColor">#F5B93B</Color>
    <SolidColorBrush x:Key="BoltBrush" Color="#F5B93B" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F5B93B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5AA9FF" />

    <!-- Three radii only. Mixed corner sizes are the fastest way to make a layout
         look accidental. -->
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="ShellRadius">12</CornerRadius>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
