<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!--
      For NotifyIcon. WPF has no tray-icon primitive of its own, and pulling in a
      third-party control for one icon is a worse trade than enabling the WinForms
      reference that already ships with the desktop SDK.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UsbDoctor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Gives the .exe its shell icon. Generated by tools/build-icon.ps1, which is
      the source of truth for the artwork - the .ico is a build product committed
      so a clone can build without PowerShell.
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Overrides the solution-wide setting. WPF is not compatible with invariant
      globalization: every data binding resolves a culture through
      XmlLanguage.GetSpecificCulture, which throws "Cannot find non-neutral
      culture related to 'en-us'" when the ICU data is absent. The window fails to
      construct and the process dies at startup. The console and engine projects
      keep the invariant setting, where it costs nothing.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Solid-state detection for the Shredder, which has to know what it may claim:
         on an SSD an overwrite does not replace the original blocks. WMI's storage
         namespace is the only place Windows exposes MediaType. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the window and the tray load the same
         file rather than keeping a second copy of the artwork. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsbDoctor.Engine\UsbDoctor.Engine.csproj" />
    <ProjectReference Include="..\UsbDoctor.Maintenance\UsbDoctor.Maintenance.csproj" />
  </ItemGroup>

</Project>
