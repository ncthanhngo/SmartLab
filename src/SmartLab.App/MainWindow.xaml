<Window x:Class="SmartLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SmartLab.App"
        xmlns:views="clr-namespace:SmartLab.App.Views"
        Title="Smart Lab" Height="740" Width="1120"
        MinHeight="600" MinWidth="900"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <views:SectionTemplateSelector x:Key="SectionTemplates" />
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="{DynamicResource ShellTopColor}" Offset="0" />
            <GradientStop Color="{DynamicResource ShellBottomColor}" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Grid Grid.Row="0">
            <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Left"
                     Margin="18,0,0,0" VerticalAlignment="Center" />

            <TextBlock Text="{Binding SelectedSection.Title}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="12.5"
                       Foreground="{DynamicResource TextMutedBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                        ToolTip="Minimise" Click="OnMinimise" />
                <Button Style="{StaticResource WindowButton}" Content="&#xE922;"
                        ToolTip="Maximise" Click="OnMaximise" />
                <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                        ToolTip="Close to tray" Click="OnCloseClicked" />
            </StackPanel>
        </Grid>

        <!-- ==================== body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Eight wider than it was: the rail now scrolls, and a scrollbar
                     laid over the cells clips the longer labels. -->
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== glyph rail =====
                 Navigation shrinks to icons so the stage keeps the width. The
                 subtitles that used to explain each section move into the stage
                 heading, where there is room to say more than a rail ever had.

                 Seventeen sections do not fit at any window height, so the rail
                 scrolls and groups. Grouping turns off virtualisation, which at
                 seventeen items costs nothing - but this rail must not later be
                 pointed at a long list without turning it back on. -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource SidebarHairlineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- Implicit, because a ScrollViewer builds its own scrollbars
                             and there is no element here to hang a keyed style on. -->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>

                    <ListBox x:Name="Rail" Style="{StaticResource NavList}"
                             ItemsSource="{Binding GroupedSections.View}"
                             SelectedItem="{Binding SelectedSection}"
                             SelectionChanged="OnSectionSelected"
                             Margin="0,4,0,10" VerticalAlignment="Top">
                        <ListBox.GroupStyle>
                            <StaticResource ResourceKey="NavGroups" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Cell" Width="66" Height="46" CornerRadius="11"
                                        Background="Transparent" HorizontalAlignment="Center"
                                        ToolTip="{Binding Subtitle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="{Binding Accent}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="Label" Text="{Binding Title}"
                                                   FontSize="8" Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="62"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                        <Setter TargetName="Label" Property="Foreground"
                                                Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Cell" Property="Background"
                                                Value="{Binding SelectedFill}" />
                                        <Setter TargetName="Label" Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- ===== stage =====
                 One host rather than seventeen panels taking turns being visible.
                 Only the selected section's template is built, so a stage costs
                 nothing until someone navigates to it. -->
            <ContentControl Grid.Column="1" Margin="26,10,26,8"
                            Content="{Binding SelectedSection}"
                            ContentTemplateSelector="{StaticResource SectionTemplates}" />
        </Grid>

        <!-- ==================== status ==================== -->
        <StackPanel Grid.Row="2">
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{DynamicResource SurfaceSunkenBrush}" Padding="18,9"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
