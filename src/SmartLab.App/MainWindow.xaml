<Window x:Class="SmartLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SmartLab.App"
        xmlns:views="clr-namespace:SmartLab.App.Views"
        Title="Smart Lab" Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <views:SectionTemplateSelector x:Key="SectionTemplates" />
    </Window.Resources>

    <!-- Ctrl+K anywhere. Seventeen destinations need a keyboard, and the shortcut has
         to work from inside a section rather than only from the chrome. -->
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    </Window.InputBindings>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="{DynamicResource ShellTopColor}" Offset="0" />
            <GradientStop Color="{DynamicResource ShellBottomColor}" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== title bar ====================
                 Carries the omnibar, because a search everything can reach belongs
                 where everything can see it. -->
            <Grid Grid.Row="0">
                <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Left"
                         Margin="16,0,0,0" VerticalAlignment="Center" />

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,4" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonUp="OnOmnibarClicked">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Search sections and actions" FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Border Grid.Column="2" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,0">
                            <TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                            ToolTip="Minimise" Click="OnMinimise" />
                    <Button Style="{StaticResource WindowButton}" Content="&#xE922;"
                            ToolTip="Maximise" Click="OnMaximise" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                            ToolTip="Close to tray" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>

            <!-- ==================== body ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== the rail =====
                     Labelled and grouped. Seventeen glyphs at 46 px overflowed every
                     window height, and navigation that scrolls cannot be remembered;
                     at 28 px with names the whole list fits at the default size and
                     only scrolls near the minimum. -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource SidebarHairlineBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ScrollViewer.Resources>

                        <ListBox x:Name="Rail" Style="{StaticResource RailList}"
                                 ItemsSource="{Binding GroupedSections.View}"
                                 SelectedItem="{Binding SelectedSection}"
                                 SelectionChanged="OnSectionSelected"
                                 VerticalAlignment="Top">
                            <ListBox.GroupStyle>
                                <StaticResource ResourceKey="RailGroups" />
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Cell" Height="28" CornerRadius="7"
                                            Background="Transparent" Padding="8,0"
                                            ToolTip="{Binding Subtitle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- A square of the section's own hue rather than a
                                                 glyph: at this size a mark carries colour
                                                 reliably and shape barely at all. -->
                                            <Border Grid.Column="0" Width="7" Height="7" CornerRadius="2.5"
                                                    VerticalAlignment="Center" Margin="3,0,10,0"
                                                    Background="{Binding Accent}" />

                                            <TextBlock x:Name="Label" Grid.Column="1"
                                                       Text="{Binding Title}" FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <Border x:Name="Badge" Grid.Column="2" CornerRadius="4"
                                                    Padding="5,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    Visibility="{Binding HasBadge,
                                                        Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding Badge}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsMouseOver,
                                                         RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                            <Setter TargetName="Cell" Property="Background"
                                                    Value="{DynamicResource SidebarHoverBrush}" />
                                            <Setter TargetName="Label" Property="Foreground"
                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsSelected,
                                                         RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                            <Setter TargetName="Cell" Property="Background"
                                                    Value="{Binding SelectedFill}" />
                                            <Setter TargetName="Label" Property="Foreground"
                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>

                                        <!-- Tone on the count, not on the label: a section is not
                                             alarming, the number it is carrying is. -->
                                        <DataTrigger Binding="{Binding BadgeTone}" Value="warn">
                                            <Setter TargetName="BadgeText" Property="Foreground"
                                                    Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BadgeTone}" Value="alert">
                                            <Setter TargetName="BadgeText" Property="Foreground"
                                                    Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- ===== the stage =====
                     One host. Only the selected section's template is built, so a
                     stage costs nothing until someone navigates to it. -->
                <ContentControl Grid.Column="1"
                                Content="{Binding SelectedSection}"
                                ContentTemplateSelector="{StaticResource SectionTemplates}" />
            </Grid>
        </Grid>

        <!-- ==================== command palette ====================
             Over everything, because it is reached from everywhere. -->
        <Grid x:Name="PaletteLayer" Background="#99000000"
              Visibility="{Binding CommandPalette.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560" VerticalAlignment="Top" Margin="0,110,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="13">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource HairlineBrush}" Padding="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <TextBox x:Name="PaletteQuery" Grid.Column="1" FontSize="14"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Text="{Binding CommandPalette.Query, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnPaletteKeyDown" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CommandPalette.Results}" Margin="0,6,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="15,7" Background="Transparent"
                                        Cursor="Hand" MouseLeftButtonUp="OnPaletteRowClicked"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- Labelled inside the palette, so speed never
                                                 hides consequence. -->
                                            <Border Style="{StaticResource Chip}"
                                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                                    Visibility="{Binding IsDestructive,
                                                        Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="irreversible"
                                                           Style="{StaticResource ChipText}"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Context}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver,
                                                     RelativeSource={RelativeSource Self}}">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
