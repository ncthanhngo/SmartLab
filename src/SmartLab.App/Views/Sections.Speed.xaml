<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls">

    <!--
        Startup takes the reading-and-list shape; Repair OS takes the console shape -
        a task list with output, because no number there is worth enlarging and the
        transcript is the content.
    -->

    <!-- ================= Startup ================= -->

    <DataTemplate x:Key="section-optimize">
        <ctl:SectionFrame Title="Startup" Status="{Binding Status}"
                          Subtitle="Run keys, RunOnce and both Startup folders. Turning one off moves the entry aside rather than deleting it, so it can be put back exactly."
                          DataContext="{Binding DataContext.Optimization,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                              IsChecked="{Binding DryRun}" Margin="0,0,16,0" FontWeight="SemiBold" />
                    <Button Content="Put back all" Style="{StaticResource GhostButton}"
                            Command="{Binding RestoreAllCommand}" Margin="0,0,8,0" />
                    <Button Content="Turn ticked off" Style="{StaticResource GhostButton}"
                            Command="{Binding DisableTickedCommand}" Margin="0,0,8,0" />
                    <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding ItemCount}" Caption="RUN AT LOGON"
                                 Proportion="{Binding GaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentOptimizeBrush}" Width="180" />
                    <ctl:Reading Value="{Binding Disabled.Count}" Caption="TURNED OFF BY SMART LAB"
                                 IsQuiet="True" Margin="26,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedItems.View}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="InsetGroups" />
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanChange}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Command}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding OriginText}"
                                                       FontSize="10" Margin="14,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Repair OS ================= -->

    <DataTemplate x:Key="section-maintenance">
        <ctl:SectionFrame Title="Repair OS" Status="{Binding Status}"
                          Subtitle="Four tools Windows ships with, run as themselves. Three need Administrator and share one elevated worker, so you are asked once."
                          DataContext="{Binding DataContext.Maintenance,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <ctl:Reading Value="{Binding CompletedCount}" Caption="TOOLS RUN" IsQuiet="True" />
            </ctl:SectionFrame.Actions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}" Padding="15,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding NeedsElevation,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="admin"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource InfoBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           MaxWidth="360" HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding CommandLine}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="Run" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Outcome}" FontSize="10"
                                                           HorizontalAlignment="Center" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Verbatim. These tools report findings this app has no business
                     interpreting, and a paraphrase would be worse than the sentence. -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Output, unedited"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Transcript}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
