<Window x:Class="SmartLab.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstalling" Height="620" Width="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceSunkenBrush}"
        FontFamily="{StaticResource UiFont}">

    <!--
        A window of its own, opened for the length of one removal. Uninstalling runs
        somebody else's installer, waits on it, then goes looking through folders and
        registry keys - and the operator has a decision to make at the end of it. On
        the section's own stage that decision competes with a list of thirty programs
        and a button that starts another removal.
    -->

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding RunningFor}" FontSize="21" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Status}" FontSize="12.5" Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- The same band every section uses, so a job in progress looks the same
             here as it does everywhere else. -->
        <ContentPresenter DockPanel.Dock="Top" Margin="-24,10,-24,0"
                          Content="{Binding Progress}"
                          ContentTemplate="{StaticResource ProgressBandTemplate}" />

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Rows found on a matching name alone are not ticked. Read them before you tick them." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoveButton" Content="Remove ticked"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding CleanLeftoversCommand}" />
                    <Button x:Name="CloseButton" Content="Close"
                            Style="{StaticResource GhostButton}" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <!-- ===== what is left ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Left behind"
                               Style="{StaticResource SectionTitle}" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="Nothing else on this machine carries its name or points at its folder."
                               FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Leftovers}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        CornerRadius="{StaticResource ControlRadius}"
                                        Padding="11,9" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top" Margin="0,2,11,0" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind}" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                                <!-- How it was found, on the row that
                                                     asks to be trusted about it. -->
                                                <Border x:Name="Guess" Style="{StaticResource Chip}"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="name only"
                                                               Style="{StaticResource ChipText}"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Location}" FontSize="11.5"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   FontSize="11.5" Margin="12,0,0,0"
                                                   VerticalAlignment="Top"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGuess}" Value="True">
                                        <Setter TargetName="Guess" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== what it did, line by line ===== -->
            <TextBlock Grid.Row="1" Text="Activity" Style="{StaticResource SectionTitle}"
                       Margin="0,14,0,6" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Activity}"
                         x:Name="Log">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="Mark" Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,2,8,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           TextWrapping="Wrap" MaxWidth="700"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="good">
                                    <Setter TargetName="Mark" Property="Text" Value="&#xE930;" />
                                    <Setter TargetName="Mark" Property="Foreground"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="warning">
                                    <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="Mark" Property="Foreground"
                                            Value="{DynamicResource WarningBrush}" />
                                    <Setter TargetName="Line" Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="alert">
                                    <Setter TargetName="Mark" Property="Text" Value="&#xE814;" />
                                    <Setter TargetName="Mark" Property="Foreground"
                                            Value="{DynamicResource DangerBrush}" />
                                    <Setter TargetName="Line" Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
