<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls"
                    xmlns:local="clr-namespace:SmartLab.App">

    <!--
        Home, Settings, About, and the fallback for a section whose stage has not been
        built yet.

        Every section template binds its DataContext back to the window's view model.
        The ContentControl hands each template a NavSection, which carries a section's
        identity but none of its data.
    -->

    <!-- ================= not built yet ================= -->

    <DataTemplate x:Key="section-missing">
        <ctl:SectionFrame Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <TextBlock Style="{StaticResource BodyText}"
                       Text="This section is in the rail but its stage has not been built yet." />
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Home =================

         Verdict and evidence. This was Smart Scan, one of seventeen equal entries,
         which made the front door a room you had to find. Nothing here acts.
    -->

    <DataTemplate x:Key="section-home">
        <Grid DataContext="{Binding DataContext.SmartScan,
                  RelativeSource={RelativeSource AncestorType=Window}}"
              Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== the headline ===== -->
            <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock Text="{Binding Headline}" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding HeadlineDetail}" FontSize="13.5" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="620" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- What is being measured right now, and what the run concluded.
                     Home is the one screen with no SectionFrame to draw this for it,
                     so it draws its own - and before it had one, pressing Run showed
                     three breathing circles and nothing else. Under the headline
                     rather than over it: the band appears and disappears, and a
                     heading that moves when it does is a heading nobody trusts. -->
                <ContentPresenter Margin="-24,14,-24,0" Content="{Binding Progress}"
                                  ContentTemplate="{StaticResource ProgressBandTemplate}" />
            </StackPanel>

            <!-- ===== the three pillars ===== -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cleanup -->
                <StackPanel Grid.Column="0" x:Name="OrbOne">
                    <Border x:Name="CleanupOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarCleanupTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarCleanupBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Drawn rather than a font glyph. Every MDL2 drive is a thin
                             outline that turns to wire at this size, next to two solid
                             neighbours; a platter and a spindle read as storage and hold
                             their weight. -->
                        <Grid Width="62" Height="62" HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Stroke="#FFFFFF" StrokeThickness="5" Opacity="0.94" />
                            <Ellipse Width="16" Height="16" Fill="#FFFFFF" Opacity="0.94" />
                            <Path Data="M 31,31 L 50,17" Stroke="#FFFFFF" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.94" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Reclaim" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Space nothing is using" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding CleanupValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarCleanupBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Cleanup}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Protection -->
                <StackPanel Grid.Column="1" x:Name="OrbTwo">
                    <Border x:Name="ProtectionOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarProtectionTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarProtectionBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" Style="{StaticResource PillarGlyph}" />
                    </Border>

                    <TextBlock Text="Security" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Hiding, and what Defender names" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding ProtectionValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarProtectionBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Protection}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Speed -->
                <StackPanel Grid.Column="2" x:Name="OrbThree">
                    <Border x:Name="SpeedOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarSpeedTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarSpeedBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource PillarGlyph}" />
                    </Border>

                    <TextBlock Text="Performance" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Things to do, not things wrong" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding SpeedValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarSpeedBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Speed}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- ===== what is being measured, then what will be acted on =====
                 Present from the first row onwards rather than only at the end: a row
                 that appears as its section starts is how the operator watches the run
                 rather than waits it out. It is also the list the confirm button acts
                 on, and nothing outside it is touched. -->
            <Border Grid.Row="2" MaxHeight="150" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetRow}" Padding="15,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsActionable}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <Border Grid.Column="1" Width="7" Height="7" CornerRadius="2.5"
                                                VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{Binding Section.Accent}" />

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="RowSummary" Text="{Binding Summary}"
                                                       FontSize="11.5"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <Border x:Name="Measuring" Grid.Column="3"
                                                Style="{StaticResource Chip}" Visibility="Collapsed">
                                            <TextBlock Text="measuring" Style="{StaticResource ChipText}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <Border x:Name="Skip" Grid.Column="3" Style="{StaticResource Chip}"
                                                Visibility="Collapsed">
                                            <TextBlock Text="could not run" Style="{StaticResource ChipText}"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Border>

                                        <Button Grid.Column="4" Content="Open"
                                                Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                                Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Skipped}" Value="True">
                                        <Setter TargetName="Skip" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="measuring">
                                        <Setter TargetName="Measuring" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RowSummary" Property="Text"
                                                Value="Measuring now. Nothing is being changed." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="applying">
                                        <Setter TargetName="Measuring" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RowSummary" Property="Text"
                                                Value="Running this section's own verb now." />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ===== the one control the screen is arranged around ===== -->
            <StackPanel Grid.Row="3" Margin="0,16,0,18" HorizontalAlignment="Center">
                <Grid>
                    <Button x:Name="RunButton" Content="Run" Style="{StaticResource RunButton}"
                            Command="{Binding ScanCommand}" />

                    <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource RunButton}"
                            Command="{Binding ApplyCommand}" Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="RunCaption" Text="Measures five sections. Changes nothing."
                           FontSize="12.5" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <!-- Named for what it is doing once pressed, because the thing it
                     stops may take a moment to unwind and a button that looks
                     unpressed invites a second press. -->
                <Button x:Name="StopButton" Content="Stop"
                        Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <!-- The orbs breathe only while something is genuinely being measured, and
                 settle the moment it stops. A still window therefore means nothing is
                 running, which is a thing the operator can rely on. -->
            <DataTrigger Value="True"
                         Binding="{Binding DataContext.SmartScan.IsScanning,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="BreatheOne" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="CleanupOrb" />
                    <BeginStoryboard Name="BreatheTwo" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="ProtectionOrb" />
                    <BeginStoryboard Name="BreatheThree" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="SpeedOrb" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BreatheOne" />
                    <StopStoryboard BeginStoryboardName="BreatheTwo" />
                    <StopStoryboard BeginStoryboardName="BreatheThree" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="CleanupOrb" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="ProtectionOrb" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="SpeedOrb" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Run becomes Confirm once there is something to confirm. Two presses,
                 never one, and the second is a different word for a different act. -->
            <DataTrigger Value="True"
                         Binding="{Binding DataContext.SmartScan.IsReviewing,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="RunButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ConfirmButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="RunCaption" Property="Text"
                        Value="Acts on the ticked rows above, using what the scan already found." />
            </DataTrigger>

            <DataTrigger Value="True"
                         Binding="{Binding DataContext.SmartScan.IsStopping,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="StopButton" Property="Content" Value="Stopping..." />
                <Setter TargetName="StopButton" Property="IsEnabled" Value="False" />
            </DataTrigger>

            <DataTrigger Value="Done"
                         Binding="{Binding DataContext.SmartScan.Phase,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="ConfirmButton" Property="Content" Value="Run again" />
                <Setter TargetName="ConfirmButton" Property="Command"
                        Value="{Binding DataContext.SmartScan.ScanCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter TargetName="RunCaption" Property="Text"
                        Value="Run again to see what is left." />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= History ================= -->

    <!--
        What this app has already done. Verdict and evidence, like Repair: the answer
        is a state rather than a fraction, and the evidence is the journal itself.

        It exists because the journal was written from the first release and shown
        nowhere. Three separate repairs of one infected stick each recorded
        "0 succeeded, 3 failed" while the window said nothing was wrong, and the
        operator was left believing the scanner had been at fault.
    -->

    <DataTemplate x:Key="section-history">
        <ctl:SectionFrame Title="History" Status="{Binding Status}"
                          Subtitle="Every write this app makes is journalled as it happens. This reads those journals back."
                          DataContext="{Binding DataContext.History,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- Only offered for a run that quarantined something still sitting
                         in the store. Quarantine was always a move, and until now
                         nothing ever moved anything back. -->
                    <Button Content="Put back what this quarantined"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RestoreRunCommand}" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Moves the files this run put in quarantine back where they came from. Offered only when they are still there and nothing else has taken their place." />
                    <Button Content="Open folder" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="Reload" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBand}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Lamp" Grid.Column="0" Style="{StaticResource VerdictLamp}"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock x:Name="LampGlyph" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource VerdictHeadline}" />
                            <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource VerdictDetail}"
                                       MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <ctl:Reading Value="{Binding RunCount}" Caption="RUNS" />
                            <ctl:Reading Value="{Binding FailureCount}" Caption="FAILED WRITES"
                                         IsQuiet="True" Margin="22,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The runs, newest first: what an operator remembers doing. -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Runs"
                                       Style="{StaticResource SectionTitle}" />

                            <TextBlock DockPanel.Dock="Top" Text="{Binding Folder}" FontSize="11"
                                       Margin="0,0,0,8" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Runs}"
                                     SelectedItem="{Binding SelectedRun}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{StaticResource ControlRadius}"
                                                Padding="11,9" Margin="0,0,0,5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Volume}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border x:Name="Failed" Style="{StaticResource Chip}"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="failed"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource DangerBrush}" />
                                                    </Border>
                                                    <Border x:Name="Unfinished" Style="{StaticResource Chip}"
                                                            Visibility="Collapsed">
                                                        <TextBlock Text="unfinished"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Started}" FontSize="11.5"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="alert">
                                                <Setter TargetName="Failed" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="warning">
                                                <Setter TargetName="Unfinished" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Every line of the run that is selected, in the journal's own words. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedRun.Outcome}"
                                       Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />

                            <ListBox Style="{StaticResource PlainList}"
                                     ItemsSource="{Binding SelectedRun.Lines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="Mark" Grid.Column="0" Text="&#xE930;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Margin="0,2,8,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentBrush}" />

                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11.5"
                                                       Margin="0,0,10,0" VerticalAlignment="Top"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11.5"
                                                       Margin="0,0,10,0" MinWidth="110"
                                                       VerticalAlignment="Top" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding Target}" FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                                <TextBlock x:Name="Detail" Text="{Binding Detail}"
                                                           FontSize="11.5" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" Visibility="Collapsed"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                <Setter TargetName="Detail" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="alert">
                                                <Setter TargetName="Mark" Property="Text" Value="&#xE814;" />
                                                <Setter TargetName="Mark" Property="Foreground"
                                                        Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </ctl:SectionFrame>

        <DataTemplate.Triggers>
            <DataTrigger Value="good"
                         Binding="{Binding DataContext.History.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="Lamp" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE930;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Value="warning"
                         Binding="{Binding DataContext.History.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE7BA;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Settings ================= -->

    <DataTemplate x:Key="section-settings">
        <ctl:SectionFrame Title="Settings"
                          Subtitle="How Smart Lab looks, and what it does when you are not looking at it."
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0" MaxWidth="660" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Light theme" IsChecked="{Binding IsLightTheme}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                       Text="Follows Windows the first time you run the app, then remembers what you pick here. Both themes are chosen rather than inverted." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Watching" Style="{StaticResource SectionTitle}" />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Scan automatically when a USB is plugged in"
                                      IsChecked="{Binding AutoScanOnInsert}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="The drive that started this project had carried its worm for six days before anyone looked." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Keep watching in the tray when the window is closed"
                                      IsChecked="{Binding KeepWatchingInTray}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="Watching runs on the window's message loop, so closing would otherwise stop it. Exit from the tray menu." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                       Text="Registers for this user only, starting in the tray. Never machine-wide." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= About ================= -->

    <!--
        Three questions, in the order someone asks them: what is this, what can it do,
        and is there a newer one. Identity and the update check stay on the left where
        they are always visible; the two lists scroll on the right, because between
        them they are longer than any window.
    -->
    <DataTemplate x:Key="section-about">
        <ctl:SectionFrame Title="About"
                          Subtitle="What Smart Lab is, what each section does, and what every version changed."
                          Status="{Binding About.UpdateStatus}"
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== identity and the update check ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <Control Style="{StaticResource LogoMark}" HorizontalAlignment="Center" />
                            <TextBlock Text="Smart Lab" Style="{StaticResource DisplayText}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Center"
                                     Margin="0,8,0,0" />

                            <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                                       Margin="0,16,0,0"
                                       Text="Triage, recovery and maintenance for Windows machines and the drives they read. Built from a real worm infection: the data was not hidden, it was moved into a folder named with a single invisible character." />

                            <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="16,12" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding Source={x:Static local:MainViewModel.AppVersion},
                                                              StringFormat='Version {0}'}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="{Binding Source={x:Static local:MainViewModel.AppAuthor}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0"
                            DataContext="{Binding About}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />

                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,14"
                                       Text="{Binding UpdateStatus}" />

                            <!-- Both appear only once a check has found a newer
                                 release. Installing replaces the running application,
                                 so it is never what the first press does - and it
                                 stays hidden when the release carries no package this
                                 app can verify. -->
                            <Button Content="Download and install"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding CanInstall,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Open the release page"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Command="{Binding OpenReleasesCommand}"
                                    Visibility="{Binding HasNewerVersion,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Check for updates"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CheckForUpdateCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== what it does, and what changed ===== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="What it does" Style="{StaticResource SectionTitle}" />

                                <ItemsControl ItemsSource="{Binding About.FeatureGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource GroupLabel}"
                                                           Margin="0,10,0,5" />

                                                <ItemsControl ItemsSource="{Binding Features}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Release notes" Style="{StaticResource SectionTitle}" />

                                <ItemsControl ItemsSource="{Binding Source={x:Static local:AboutViewModel.ReleaseNotes}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Version}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Date}"
                                                               FontSize="12.5" VerticalAlignment="Center"
                                                               Margin="10,0,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>

                                                <!-- Added and Fixed are separate lists, not one
                                                     mixed one: a reader deciding whether to
                                                     upgrade is asking a different question in
                                                     each case. -->
                                                <ItemsControl ItemsSource="{Binding Added}"
                                                              Visibility="{Binding HasAdditions,
                                                                  Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="6" Height="6"
                                                                        CornerRadius="3" Margin="2,7,10,0"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource AccentBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Fixed" Style="{StaticResource GroupLabel}"
                                                           Margin="0,10,0,4"
                                                           Visibility="{Binding HasFixes,
                                                               Converter={StaticResource BoolToVisibility}}" />

                                                <ItemsControl ItemsSource="{Binding Fixed}"
                                                              Visibility="{Binding HasFixes,
                                                                  Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="6" Height="6"
                                                                        CornerRadius="3" Margin="2,7,10,0"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource WarningBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
