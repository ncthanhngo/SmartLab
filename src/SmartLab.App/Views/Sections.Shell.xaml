<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls"
                    xmlns:local="clr-namespace:SmartLab.App">

    <!--
        Home, Settings, About, and the fallback for a section whose stage has not been
        built yet.

        Every section template binds its DataContext back to the window's view model.
        The ContentControl hands each template a NavSection, which carries a section's
        identity but none of its data.
    -->

    <!-- ================= not built yet ================= -->

    <DataTemplate x:Key="section-missing">
        <ctl:SectionFrame Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <TextBlock Style="{StaticResource BodyText}"
                       Text="This section is in the rail but its stage has not been built yet." />
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Home =================

         Verdict and evidence. This was Smart Scan, one of seventeen equal entries,
         which made the front door a room you had to find. Nothing here acts.
    -->

    <DataTemplate x:Key="section-home">
        <Grid DataContext="{Binding DataContext.SmartScan,
                  RelativeSource={RelativeSource AncestorType=Window}}"
              Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== the headline ===== -->
            <StackPanel Grid.Row="0" Margin="0,10,0,0">
                <TextBlock Text="{Binding Headline}" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding HeadlineDetail}" FontSize="12.5" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="620" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- ===== the three pillars ===== -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cleanup -->
                <StackPanel Grid.Column="0" x:Name="OrbOne">
                    <Border x:Name="CleanupOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarCleanupTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarCleanupBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource PillarGlyph}" />
                    </Border>

                    <TextBlock Text="Cleanup" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Space nothing is using" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding CleanupValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarCleanupBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Cleanup}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Protection -->
                <StackPanel Grid.Column="1" x:Name="OrbTwo">
                    <Border x:Name="ProtectionOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarProtectionTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarProtectionBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE72E;" Style="{StaticResource PillarGlyph}" />
                    </Border>

                    <TextBlock Text="Protection" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Hiding, and what Defender names" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding ProtectionValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarProtectionBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Protection}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Speed -->
                <StackPanel Grid.Column="2" x:Name="OrbThree">
                    <Border x:Name="SpeedOrb" Style="{StaticResource PillarOrb}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="{DynamicResource PillarSpeedTop}" Offset="0" />
                                <GradientStop Color="{DynamicResource PillarSpeedBottom}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource PillarGlyph}" />
                    </Border>

                    <TextBlock Text="Speed" Style="{StaticResource PillarName}" />
                    <TextBlock Text="Things to do, not things wrong" Style="{StaticResource PillarCaption}" />
                    <TextBlock Text="{Binding SpeedValue}" Style="{StaticResource PillarValue}"
                               Foreground="{DynamicResource PillarSpeedBrush}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Review details" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding OpenPillarCommand}" CommandParameter="{x:Static local:Pillar.Speed}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- ===== what will be acted on =====
                 Only after a scan. This is the list the confirm button acts on, and
                 nothing outside it is touched. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" MaxHeight="150"
                    Margin="0,10,0,0"
                    Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetRow}" Padding="15,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsActionable}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <Border Grid.Column="1" Width="7" Height="7" CornerRadius="2.5"
                                                VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{Binding Section.Accent}" />

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <Border x:Name="Skip" Grid.Column="3" Style="{StaticResource Chip}"
                                                Visibility="Collapsed">
                                            <TextBlock Text="could not run" Style="{StaticResource ChipText}"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Border>

                                        <Button Grid.Column="4" Content="Open"
                                                Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                                Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Skipped}" Value="True">
                                        <Setter TargetName="Skip" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ===== the one control the screen is arranged around ===== -->
            <StackPanel Grid.Row="3" Margin="0,16,0,18" HorizontalAlignment="Center">
                <Grid>
                    <Button x:Name="RunButton" Content="Run" Style="{StaticResource RunButton}"
                            Command="{Binding ScanCommand}" />

                    <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource RunButton}"
                            Command="{Binding ApplyCommand}" Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="RunCaption" Text="Measures everything. Changes nothing."
                           FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <!-- The orbs breathe only while something is genuinely being measured, and
                 settle the moment it stops. A still window therefore means nothing is
                 running, which is a thing the operator can rely on. -->
            <DataTrigger Value="True"
                         Binding="{Binding DataContext.SmartScan.IsScanning,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="BreatheOne" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="CleanupOrb" />
                    <BeginStoryboard Name="BreatheTwo" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="ProtectionOrb" />
                    <BeginStoryboard Name="BreatheThree" Storyboard="{StaticResource OrbBreathe}"
                                     Storyboard.TargetName="SpeedOrb" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BreatheOne" />
                    <StopStoryboard BeginStoryboardName="BreatheTwo" />
                    <StopStoryboard BeginStoryboardName="BreatheThree" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="CleanupOrb" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="ProtectionOrb" />
                    <BeginStoryboard Storyboard="{StaticResource OrbSettle}"
                                     Storyboard.TargetName="SpeedOrb" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Run becomes Confirm once there is something to confirm. Two presses,
                 never one, and the second is a different word for a different act. -->
            <DataTrigger Value="True"
                         Binding="{Binding DataContext.SmartScan.IsReviewing,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="RunButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ConfirmButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="RunCaption" Property="Text"
                        Value="Acts on the ticked rows above, using what the scan already found." />
            </DataTrigger>

            <DataTrigger Value="Done"
                         Binding="{Binding DataContext.SmartScan.Phase,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="ConfirmButton" Property="Content" Value="Run again" />
                <Setter TargetName="ConfirmButton" Property="Command"
                        Value="{Binding DataContext.SmartScan.ScanCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter TargetName="RunCaption" Property="Text"
                        Value="Run again to see what is left." />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Settings ================= -->

    <DataTemplate x:Key="section-settings">
        <ctl:SectionFrame Title="Settings"
                          Subtitle="How Smart Lab looks, and what it does when you are not looking at it."
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0" MaxWidth="660" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Light theme" IsChecked="{Binding IsLightTheme}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                       Text="Follows Windows the first time you run the app, then remembers what you pick here. Both themes are chosen rather than inverted." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Watching" Style="{StaticResource SectionTitle}" />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Scan automatically when a USB is plugged in"
                                      IsChecked="{Binding AutoScanOnInsert}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="The drive that started this project had carried its worm for six days before anyone looked." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Keep watching in the tray when the window is closed"
                                      IsChecked="{Binding KeepWatchingInTray}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                       Text="Watching runs on the window's message loop, so closing would otherwise stop it. Exit from the tray menu." />

                            <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                      Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                       Text="Registers for this user only, starting in the tray. Never machine-wide." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= About ================= -->

    <DataTemplate x:Key="section-about">
        <ctl:SectionFrame Title="About"
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">
            <Border Style="{StaticResource Card}" Padding="34"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <Control Style="{StaticResource LogoMark}" HorizontalAlignment="Center" />
                    <TextBlock Text="Smart Lab" Style="{StaticResource DisplayText}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Center"
                             Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                               Margin="0,18,0,0" MaxWidth="400"
                               Text="Triage, recovery and maintenance for Windows machines and the drives they read. Built from a real worm infection: the data was not hidden, it was moved into a folder named with a single invisible character." />
                    <Border Background="{DynamicResource SurfaceSunkenBrush}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="16,12" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                                       Text="{Binding Source={x:Static local:MainViewModel.AppVersion},
                                                      StringFormat='Version {0}'}" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding Source={x:Static local:MainViewModel.AppAuthor}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
