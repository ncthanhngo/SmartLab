<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls"
                    xmlns:local="clr-namespace:SmartLab.App">

    <!--
        Stages that belong to the application rather than to a feature group, plus the
        fallback for a section whose stage has not been built yet.

        Every section template binds its DataContext back to the window's view model.
        The ContentControl hands each template a NavSection, which carries a section's
        identity but none of its data.
    -->

    <!-- ================= not built yet ================= -->

    <DataTemplate x:Key="section-missing">
        <Border Style="{StaticResource Card}" Padding="36"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}"
                           FontSize="22" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                           Margin="0,18,0,0"
                           Text="This section is in the rail but its stage has not been built yet." />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================= Smart Scan ================= -->

    <DataTemplate x:Key="section-smart">
        <DockPanel DataContext="{Binding DataContext.SmartScan,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14"
                    Height="210" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="What was measured"
                               Style="{StaticResource SectionTitle}" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Results}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        CornerRadius="{StaticResource ControlRadius}"
                                        Padding="11,8" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Section.Glyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,11,0"
                                                   Foreground="{Binding Section.Accent}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10.5"
                                                   Margin="12,0,0,0" MinWidth="86" TextAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <!-- A skipped section is called out, never
                                                             folded into a clean-looking row. -->
                                                        <DataTrigger Binding="{Binding Skipped}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="3" Content="Open"
                                                Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                                Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="164" Height="164" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="13"
                                         Percent="{Binding Source={x:Static local:SmartScanViewModel.GaugePercent}}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}">
                            <ctl:RadialGauge.Style>
                                <Style TargetType="ctl:RadialGauge">
                                    <Setter Property="ValueBrush" Value="{DynamicResource AccentSmartBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="good">
                                            <Setter Property="ValueBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="warning">
                                            <Setter Property="ValueBrush" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="danger">
                                            <Setter Property="ValueBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:RadialGauge.Style>
                        </ctl:RadialGauge>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FindingCount}" FontSize="38"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="findings" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="480" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" Padding="38,10" />
                        <Button Content="Stop" Style="{StaticResource GhostButton}"
                                Command="{Binding CancelCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Settings ================= -->

    <DataTemplate x:Key="section-settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource DisplayText}" FontSize="20" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,18"
                                   Text="Both themes are chosen rather than inverted, so neither is the other one turned inside out." />

                        <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                  Content="Light theme" IsChecked="{Binding IsLightTheme}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                   Text="Follows Windows the first time you run the app, then remembers what you pick here." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Watching" Style="{StaticResource DisplayText}" FontSize="20" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,18"
                                   Text="How Smart Lab behaves when you are not looking at it." />

                        <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                  Content="Scan automatically when a USB is plugged in"
                                  IsChecked="{Binding AutoScanOnInsert}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                   Text="The drive that started this project had carried its worm for six days before anyone looked." />

                        <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                  Content="Keep watching in the tray when the window is closed"
                                  IsChecked="{Binding KeepWatchingInTray}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,16"
                                   Text="Watching runs on the window's message loop, so closing would otherwise stop it. Exit from the tray menu." />

                        <CheckBox Style="{StaticResource ToggleCheck}" Margin="0,0,0,4"
                                  Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="43,0,0,0"
                                   Text="Registers for this user only, starting in the tray. Never machine-wide." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= About ================= -->

    <DataTemplate x:Key="section-about">
        <Border Style="{StaticResource Card}" Padding="36"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="450"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel HorizontalAlignment="Center">
                <Control Style="{StaticResource LogoMark}" HorizontalAlignment="Center" />
                <TextBlock Text="Smart Lab" Style="{StaticResource DisplayText}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Center"
                         Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                           Margin="0,18,0,0" MaxWidth="380"
                           Text="Triage and recovery for USB drives whose files have disappeared. Built from a real worm infection: the data was not hidden, it was moved into a folder named with a single invisible character." />
                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource ControlRadius}"
                        Padding="16,12" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                                   Text="{Binding Source={x:Static local:MainViewModel.AppVersion},
                                                  StringFormat='Version {0}'}" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding Source={x:Static local:MainViewModel.AppAuthor}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
