<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls">

    <!--
        The Cleanup group, all three in the reading-and-list shape: a headline figure
        with a real denominator, quiet context beside it, and the evidence at full
        height underneath. The list is what an operator came to read.
    -->

    <!-- ================= Temp & Cache ================= -->

    <DataTemplate x:Key="section-cleanup">
        <ctl:SectionFrame Title="Temp &amp; Cache" Status="{Binding Status}"
                          Subtitle="Nine places whose entire purpose is holding disposable data. The Recycle Bin is not one of them - it has its own section."
                          DataContext="{Binding DataContext.Cleanup,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <!-- Analyse is the dry run: it measures every category and deletes
                     nothing, and Clean stays dead until it has run. -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Clean ticked" Style="{StaticResource GhostButton}"
                            Command="{Binding CleanCommand}" Margin="0,0,8,0" />
                    <Button Content="Measure" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AnalyseCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding TotalText}" Caption="TICKED FOR REMOVAL"
                                 Proportion="{Binding GaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentCleanupBrush}" Width="180" />
                    <ctl:Reading Value="{Binding MeasuredText}" Caption="MEASURED"
                                 IsQuiet="True" Margin="26,0,0,0" />
                    <ctl:Reading Value="{Binding FileCount, StringFormat={}{0:N0}}" Caption="FILES"
                                 IsQuiet="True" Margin="26,0,0,0" />
                    <ctl:Reading Value="{Binding NeedsAdminCount}" Caption="NEED ADMIN"
                                 IsQuiet="True" Margin="26,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}" Padding="15,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding NeedsElevation,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="admin"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource InfoBrush}" />
                                                    </Border>

                                                    <!-- The caution is on the row, because the row is
                                                         where the decision is. -->
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding HasCaution,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Caution}"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}" FontSize="13"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="11.5"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding Files, StringFormat={}{0:N0} files}"
                                                           Visibility="{Binding Measured,
                                                               Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Recycle Bins ================= -->

    <DataTemplate x:Key="section-trash">
        <ctl:SectionFrame Title="Recycle Bins" Status="{Binding Status}"
                          Subtitle="Every bin starts unticked, on every drive. This is the one place Windows already keeps deleted files intact, and Deleted files recovers from exactly here."
                          DataContext="{Binding DataContext.TrashBins,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <!-- Measure is the dry run, and every bin starts unticked besides. -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Empty ticked" Style="{StaticResource GhostButton}"
                            Command="{Binding EmptyTickedCommand}" Margin="0,0,8,0" />
                    <Button Content="Measure" Style="{StaticResource PrimaryButton}"
                            Command="{Binding MeasureCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding ItemCount, StringFormat={}{0:N0}}"
                                 Caption="DELETED ITEMS STILL RECOVERABLE"
                                 Proportion="{Binding GaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentTrashBrush}" Width="250" />
                    <ctl:Reading Value="{Binding TotalText}" Caption="ON DISK"
                                 IsQuiet="True" Margin="26,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Bins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}" Padding="15,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Root}" FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                                               Margin="9,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                                    <!-- A removable drive may not be here tomorrow,
                                                         and its bin is exactly the population the
                                                         Deleted files section tries to carve back. -->
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding IsRemovable,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="removable"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Margin="14,0,0,0"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
