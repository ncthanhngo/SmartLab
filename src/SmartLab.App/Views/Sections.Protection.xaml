<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls"
                    xmlns:local="clr-namespace:SmartLab.App">

    <!-- ================= Repair ================= -->

    <DataTemplate x:Key="section-repair">
        <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

            <!-- drive strip: only the volume sections need one, so it lives
                 with them rather than permanently in the chrome -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="DRIVE" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <ComboBox Style="{StaticResource DriveCombo}" Width="250"
                          ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding Root, Mode=OneWay}" />
                                <Run Text="{Binding Label, Mode=OneWay}" />
                                <Run Text="{Binding FileSystem, Mode=OneWay}"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Refresh" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshDrivesCommand}" Margin="8,0,0,0" />
                <CheckBox Style="{StaticResource ToggleCheck}" Margin="18,0,0,0"
                          Content="Scan on insert" IsChecked="{Binding AutoScanOnInsert}" />
            </StackPanel>

            <!-- findings and actions sit below the stage -->
            <Grid DockPanel.Dock="Bottom" Height="210" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Findings"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Findings}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Button Content="Apply selected" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyCommand}" />
                            <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                                      IsChecked="{Binding DryRun}" Margin="14,0,0,0"
                                      FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Proposed actions"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Actions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            Padding="11,9" Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top" Margin="0,2,10,0" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Kind}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="irreversible" FontSize="10"
                                                               Margin="8,0,0,0" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Visibility="{Binding IsDestructive,
                                                                   Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource CaptionText}"
                                                           MaxWidth="420" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="176" Height="176" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="13"
                                         Percent="{Binding Source={x:Static local:MainViewModel.RepairGaugePercent}}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}">
                            <ctl:RadialGauge.Style>
                                <Style TargetType="ctl:RadialGauge">
                                    <Setter Property="ValueBrush" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="good">
                                            <Setter Property="ValueBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="warning">
                                            <Setter Property="ValueBrush" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="danger">
                                            <Setter Property="ValueBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="ValueBrush" Value="{DynamicResource InfoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:RadialGauge.Style>
                        </ctl:RadialGauge>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Text has to come from a setter, not an attribute: a locally
                                 set value outranks a trigger, so an attribute here would
                                 freeze the number at the threat count during the scan. -->
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="40" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Text" Value="{Binding ThreatCount}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text"
                                                        Value="{Binding ScanEntries, StringFormat={}{0:N0}}" />
                                                <Setter Property="FontSize" Value="30" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Text" Value="threats" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="entries scanned" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="430" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding ScanningPath}" Margin="0,8,0,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" MaxWidth="460"
                               TextTrimming="WordEllipsis" FlowDirection="RightToLeft"
                               Visibility="{Binding IsScanning,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" Margin="0,16,0,0"
                            Padding="34,10" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= Malware ================= -->

    <DataTemplate x:Key="section-malware">
        <DockPanel DataContext="{Binding DataContext.Malware,
                       RelativeSource={RelativeSource AncestorType=Window}}">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="SCAN" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <TextBox Style="{StaticResource PathBox}" Text="{Binding ScanPath}" Width="420" />
                <Button Content="Stop" Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}" Margin="10,0,0,0" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceSunkenBrush}" Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" />
            </Border>

            <Grid DockPanel.Dock="Bottom" Height="200" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedFindings.View}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="InsetGroups" />
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Defender's output"
                                   Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding DefenderOutput}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- centre stage -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                        <ctl:RadialGauge Thickness="12"
                                         Percent="{Binding Source={x:Static local:MalwareRemovalViewModel.GaugePercent}}"
                                         TrackBrush="{DynamicResource GaugeTrackBrush}">
                            <ctl:RadialGauge.Style>
                                <Style TargetType="ctl:RadialGauge">
                                    <Setter Property="ValueBrush" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="good">
                                            <Setter Property="ValueBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="warning">
                                            <Setter Property="ValueBrush" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeadlineTone}" Value="danger">
                                            <Setter Property="ValueBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:RadialGauge.Style>
                        </ctl:RadialGauge>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ThreatCount}" FontSize="32"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="findings" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Headline}" Style="{StaticResource DisplayText}"
                               FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" MaxWidth="490" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="Ask Defender" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" Padding="30,9" />
                        <Button Content="Remove what it found" Style="{StaticResource GhostButton}"
                                Command="{Binding RemoveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
