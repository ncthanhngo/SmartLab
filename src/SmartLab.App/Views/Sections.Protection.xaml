<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls">

    <!--
        Protection, both in the verdict-and-evidence shape. Neither answer is a
        fraction - "this drive is hiding your files" has no denominator - so the lamp
        carries the tone and the findings sit under it at full height.
    -->

    <!-- ================= Repair ================= -->

    <DataTemplate x:Key="section-repair">
        <ctl:SectionFrame Title="Repair" Status="{Binding Status}"
                          Subtitle="Finds files a worm has hidden or moved, and proposes how to undo it. Producing a plan never touches the disk."
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <!-- Two presses, and the first one is the dry run. Scanning walks the
                     volume and writes nothing; the plan it leaves behind is the
                     preview, so a toggle in front of Apply would only ask a second
                     time for something the operator has already seen. -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply ticked" Style="{StaticResource GhostButton}"
                            Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                    <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <!-- The drive the verbs act on, in the header rather than floating over
                 content it is not part of. -->
            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DRIVE" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource DriveCombo}" Width="250"
                              ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding Root, Mode=OneWay}" />
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                    <Run Text="{Binding FileSystem, Mode=OneWay}"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshDrivesCommand}" Margin="8,0,0,0" />
                    <CheckBox Style="{StaticResource ToggleCheck}" Margin="20,0,0,0"
                              Content="Scan on insert" IsChecked="{Binding AutoScanOnInsert}" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBand}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Lamp" Grid.Column="0" Style="{StaticResource VerdictLamp}"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock x:Name="LampGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource VerdictHeadline}" />
                            <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource VerdictDetail}"
                                       MaxWidth="500" HorizontalAlignment="Left" />

                            <!-- Trimmed from the left: the tail is where the movement is,
                                 and a column of identical prefixes says nothing. -->
                            <TextBlock Text="{Binding ScanningPath}" Margin="0,5,0,0" FontSize="12"
                                       FontFamily="{StaticResource MonoFont}" MaxWidth="500"
                                       HorizontalAlignment="Left" TextTrimming="WordEllipsis"
                                       FlowDirection="RightToLeft"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsScanning,
                                           Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <ctl:Reading Value="{Binding ThreatCount}" Caption="THREATS" />
                            <ctl:Reading Value="{Binding AnomalyCount}" Caption="ANOMALIES"
                                         IsQuiet="True" Margin="22,0,0,0" />
                            <ctl:Reading Value="{Binding DamagedCount}" Caption="UNREADABLE"
                                         IsQuiet="True" Margin="22,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== boot =====
                     The other half of repairing a stick. Cleaning a worm off one that
                     no longer starts a PC has fixed half the problem, so the verdict
                     sits in the same section rather than in one of its own.

                     Its own buttons: these writes land on a partition table, not on
                     files, and must not travel with the tick of a proposed action
                     above. Checking is the preview here, exactly as scanning is
                     above it. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="15"
                        Margin="0,14,0,0" DataContext="{Binding Boot}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="Boot" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <TextBlock x:Name="BootHeadline" Text="{Binding Headline}" FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- Empty until a check has run, and empty again when a check
                             finds nothing a flag or a boot sector could fix. -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Fixes}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            Padding="11,9" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top" Margin="0,2,11,0" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="needs admin"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                           MaxWidth="440"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding Outcome}" FontSize="12"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                                           MaxWidth="440"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Button Content="Apply ticked" Style="{StaticResource GhostButton}"
                                    Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                            <Button Content="Check boot" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CheckCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Findings"
                                       Style="{StaticResource SectionTitle}" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Findings}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Proposed actions"
                                       Style="{StaticResource SectionTitle}" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Actions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{StaticResource ControlRadius}"
                                                Padding="11,9" Margin="0,0,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Style="{StaticResource RowCheck}"
                                                          IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Top" Margin="0,2,11,0" />
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Kind}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Border Style="{StaticResource Chip}"
                                                                Visibility="{Binding IsDestructive,
                                                                    Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="irreversible"
                                                                       Style="{StaticResource ChipText}"
                                                                       Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                                               MaxWidth="420"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </ctl:SectionFrame>

        <DataTemplate.Triggers>
            <DataTrigger Value="good"
                         Binding="{Binding DataContext.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="Lamp" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE930;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Value="warning"
                         Binding="{Binding DataContext.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE7BA;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Value="danger"
                         Binding="{Binding DataContext.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE814;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>

            <!-- The boot verdict carries its tone on the headline rather than on a
                 second lamp: one lamp per screen, or neither means anything. -->
            <DataTrigger Value="good"
                         Binding="{Binding DataContext.Boot.Tone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="BootHeadline" Property="Foreground"
                        Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Value="warning"
                         Binding="{Binding DataContext.Boot.Tone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="BootHeadline" Property="Foreground"
                        Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Value="alert"
                         Binding="{Binding DataContext.Boot.Tone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="BootHeadline" Property="Foreground"
                        Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Malware ================= -->

    <DataTemplate x:Key="section-malware">
        <ctl:SectionFrame Title="Malware" Status="{Binding Status}"
                          Subtitle="Smart Lab identifies hiding behaviour. Naming a program is Defender's job, and this section asks it rather than guessing."
                          DataContext="{Binding DataContext.Malware,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Stop" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Remove what it found" Style="{StaticResource GhostButton}"
                            Command="{Binding RemoveCommand}" Margin="0,0,8,0" />
                    <Button Content="Ask Defender" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SCAN" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding ScanPath}" Width="440" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBand}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Lamp" Grid.Column="0" Style="{StaticResource VerdictLamp}"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock x:Name="LampGlyph" Text="&#xE730;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource VerdictHeadline}" />
                            <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource VerdictDetail}"
                                       MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ctl:Reading Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"
                                     Value="{Binding ThreatCount}" Caption="FINDINGS" />
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Two halves, kept visibly separate: what Smart Lab found by how
                         it hides, and what Defender says it is. -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GroupedFindings.View}">
                                <ItemsControl.GroupStyle>
                                    <StaticResource ResourceKey="InsetGroups" />
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetRow}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Defender's output"
                                       Style="{StaticResource SectionTitle}" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding DefenderOutput}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </ctl:SectionFrame>

        <DataTemplate.Triggers>
            <DataTrigger Value="good"
                         Binding="{Binding DataContext.Malware.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="Lamp" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE930;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Value="warning"
                         Binding="{Binding DataContext.Malware.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE7BA;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Value="danger"
                         Binding="{Binding DataContext.Malware.HeadlineTone,
                             RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter TargetName="LampGlyph" Property="Text" Value="&#xE814;" />
                <Setter TargetName="LampGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
