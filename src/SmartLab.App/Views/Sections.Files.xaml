<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls">

    <!--
        Space Lens is the canvas: the map is the reading, so it takes the whole stage
        and the numbers move into the header. Large & Old and Deleted are
        reading-and-list. Shredder is a console whose warning is the loudest element,
        because after it runs there is nothing left to inspect.
    -->

    <!-- ================= Space Lens ================= -->

    <DataTemplate x:Key="section-spacelens">
        <ctl:SectionFrame Title="Space Lens" Status="{Binding Status}" IsCanvas="True"
                          Subtitle="Measures every folder underneath and draws them by size. Reads sizes only - nothing is opened or changed."
                          DataContext="{Binding DataContext.SpaceLens,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <ctl:Reading Value="{Binding TotalText}" Caption="IN VIEW" IsQuiet="True"
                                 Margin="0,0,20,0" />
                    <Button Content="Up" Style="{StaticResource GhostButton}"
                            Command="{Binding GoUpCommand}" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <Button Content="Measure" Style="{StaticResource PrimaryButton}"
                            Command="{Binding MeasureCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding RootFolder}" Width="380" />
                    <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="360"
                               FontFamily="{StaticResource MonoFont}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <!-- The map is the reading. Inset by 24 px on every side it would read as
                 a picture of a treemap rather than as the map itself. -->
            <ctl:Treemap ItemsSource="{Binding Tiles}"
                         TileCommand="{Binding DescendCommand}"
                         HairlineBrush="{DynamicResource SurfaceBrush}"
                         LabelBrush="White" />
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Large & Old ================= -->

    <DataTemplate x:Key="section-large">
        <ctl:SectionFrame Title="Large &amp; Old" Status="{Binding Status}"
                          Subtitle="Age is time since last written, not since last opened - Windows stops updating that clock by default. Ticked files go to the Recycle Bin, not straight out."
                          DataContext="{Binding DataContext.LargeFiles,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Send ticked to Recycle Bin" Style="{StaticResource GhostButton}"
                            Command="{Binding RecycleTickedCommand}" Margin="0,0,8,0" />
                    <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding RootFolder}" Width="300" />
                    <TextBlock Text="BIGGER THAN" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="18,0,8,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding MinimumMegabytes}" Width="58" />
                    <TextBlock Text="MB" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="OLDER THAN" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="18,0,8,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding MinimumMonths}" Width="46" />
                    <TextBlock Text="months" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding FileCount}" Caption="FILES MATCHED"
                                 Proportion="{Binding GaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentLargeBrush}" Width="180" />
                    <ctl:Reading Value="{Binding TotalText}" Caption="ON DISK"
                                 IsQuiet="True" Margin="26,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedFiles.View}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="InsetGroups" />
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Path}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding AgeText}" FontSize="10"
                                                       Margin="14,0,0,0" MinWidth="60" TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                                       FontSize="11.5" Margin="16,0,0,0" MinWidth="70"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Deleted ================= -->

    <DataTemplate x:Key="section-deleted">
        <ctl:SectionFrame Title="Deleted files" Status="{Binding RawStatus}"
                          Subtitle="Reads the device directly, below the mounted filesystem. Recovery assumes the data was not fragmented, so every result is a candidate."
                          DataContext="{Binding DataContext,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Recover ticked" Style="{StaticResource GhostButton}"
                            Command="{Binding RecoverDeletedCommand}" Margin="0,0,8,0" />
                    <Button Content="Read deleted entries" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReadDeletedCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DRIVE" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource DriveCombo}" Width="230"
                              ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding Root, Mode=OneWay}" />
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="RECOVER TO" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="18,0,10,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding RecoverTo}" Width="330" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding RecoverableCount}" Caption="RECOVERABLE"
                                 Proportion="{Binding DeletedGaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentDeletedBrush}" Width="180" />
                    <ctl:Reading Value="{Binding DeletedEntries.Count}" Caption="DELETED ENTRIES FOUND"
                                 IsQuiet="True" Margin="26,0,0,0" />
                </StackPanel>

                <!-- Grouped by verdict, because that is what decides whether carving is
                     worth attempting - a flat table makes the operator read every row. -->
                <Border Style="{StaticResource Card}" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedDeletedEntries.View}">
                            <ItemsControl.GroupStyle>
                                <StaticResource ResourceKey="InsetGroups" />
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanRecover}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Path}" FontSize="11"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="10"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       FontSize="11" Margin="14,0,0,0" MinWidth="70"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

    <!-- ================= Shredder ================= -->

    <DataTemplate x:Key="section-shredder">
        <ctl:SectionFrame Title="Shredder" Status="{Binding Status}"
                          Subtitle="Overwrites a file and deletes it. There is no recovery afterwards, from here or anywhere else."
                          DataContext="{Binding DataContext.Shredder,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource ToggleCheck}" Content="Dry run"
                              IsChecked="{Binding DryRun}" Margin="0,0,16,0" FontWeight="SemiBold" />
                    <Button Content="Shred" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ShredCommand}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <ctl:SectionFrame.Settings>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FOLDER" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding Folder}" Width="380" />
                    <Button Content="Queue its files" Style="{StaticResource GhostButton}"
                            Command="{Binding AddFolderCommand}" Margin="10,0,0,0" />
                    <TextBlock Text="PASSES" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="18,0,8,0" />
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding Passes}" Width="44" />
                </StackPanel>
            </ctl:SectionFrame.Settings>

            <DockPanel>
                <!-- The caveat is the loudest element on the screen, not a footnote
                     under a ring. On an SSD an overwrite cannot promise what the
                     section's name implies, and saying so is the feature. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource VerdictBand}" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource DangerBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource VerdictLamp}"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource VerdictHeadline}" />
                            <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource VerdictDetail}"
                                       MaxWidth="640" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ctl:Reading Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"
                                     Value="{Binding FileCount}" Caption="QUEUED" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}" Padding="15,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Grid.Column="1" Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding Outcome}"
                                                           Style="{StaticResource ChipText}"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       FontSize="11" Margin="16,0,0,0" MinWidth="70"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
