<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SmartLab.App.Controls"
                    xmlns:conv="clr-namespace:SmartLab.App.Converters">

    <!--
        Uninstall is one list, filled in on arrival: it answers a single question -
        which program is going - and a second panel beside it was one more thing to
        read before answering it. Updater takes reading-and-list, because ticked over
        upgradable is a real proportion.
    -->

    <conv:ProgramIconConverter x:Key="ProgramIcon" />

    <!-- ================= Uninstall ================= -->

    <DataTemplate x:Key="section-uninstall">
        <ctl:SectionFrame Title="Uninstall" Status="{Binding Status}"
                          Progress="{Binding Progress}"
                          Subtitle="Runs each program's own uninstaller, then reports what it left behind. The list fills itself in when you open this."
                          DataContext="{Binding DataContext.Uninstall,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <!-- No dry run in front of this verb. What stands between a click and a
                 removal is the uninstaller's own confirmation - msiexec asks, and so
                 does almost every vendor - and a second one of ours in front of it
                 would only teach people to click through both. -->
            <ctl:SectionFrame.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource GhostButton}"
                            Command="{Binding ScanProgramsCommand}" Margin="0,0,8,0" />

                    <!-- Says why it is dead. A disabled button with no explanation is
                         indistinguishable from a broken one, and this one is dead
                         until a row is picked. -->
                    <Button Content="Uninstall selected" Style="{StaticResource PrimaryButton}"
                            Command="{Binding UninstallProgramCommand}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding UninstallHint}" />
                </StackPanel>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <!-- Present from the first removal onwards, including when it found
                     nothing: a panel that hides itself cannot say "nothing was left
                     behind", and that is the answer the operator most wants told
                     rather than inferred. Ticking a row is the deliberate act here. -->
                <Border DockPanel.Dock="Bottom" Padding="15" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Progress.HasRun}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Left behind" Style="{StaticResource SectionTitle}"
                                       Margin="0" VerticalAlignment="Center" />
                            <Button Content="Remove ticked" HorizontalAlignment="Right"
                                    Command="{Binding CleanLeftoversCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <TextBlock Text="Nothing. The uninstaller took its folder and its registry entry with it."
                                   FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox Style="{StaticResource PlainList}"
                                 ItemsSource="{Binding Leftovers}" MaxHeight="96">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <CheckBox Style="{StaticResource RowCheck}"
                                                  IsChecked="{Binding IsSelected}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Location}" FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="620"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Grouped by who the program was installed for, because that is
                     what decides whether removing it will be refused. -->
                <Border Style="{StaticResource Card}" Padding="15">
                    <ListBox Style="{StaticResource InsetList}"
                             ItemsSource="{Binding GroupedPrograms.View}"
                             SelectedItem="{Binding SelectedProgram}">
                        <ListBox.GroupStyle>
                            <StaticResource ResourceKey="InsetGroups" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Style="{StaticResource InsetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- The program's own icon, read from what it
                                             registered. A row of names is a registry
                                             dump; a row of icons is the list people
                                             already know from the Start menu. -->
                                        <Grid Grid.Column="0" Width="20" Height="20"
                                              Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Fallback" Text="&#xE977;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <Image x:Name="Icon" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Converter={StaticResource ProgramIcon}}" />
                                        </Grid>

                                        <TextBlock x:Name="Name" Grid.Column="1"
                                                   Text="{Binding DisplayName}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Version}"
                                                   FontSize="11.5" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" MaxWidth="90"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                                   FontSize="11.5" Margin="12,0,0,0" MinWidth="52"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- The placeholder shows only where there is no
                                         icon to draw, rather than behind every one. -->
                                    <DataTrigger Value="{x:Null}"
                                                 Binding="{Binding Converter={StaticResource ProgramIcon}}">
                                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsMouseOver,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource SurfaceRaisedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected,
                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="Name" Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </ctl:SectionFrame>

    </DataTemplate>

    <!-- ================= Updater ================= -->

    <DataTemplate x:Key="section-updater">
        <ctl:SectionFrame Title="Updater" Status="{Binding Status}"
                          Progress="{Binding Progress}"
                          Subtitle="Apps upgrade through winget, drivers through Windows Update. This app never downloads either itself."
                          DataContext="{Binding DataContext.Updater,
                              RelativeSource={RelativeSource AncestorType=Window}}">

            <ctl:SectionFrame.Actions>
                <!-- One pair of buttons per tab, not one pair that does whichever is
                     showing. The two halves run different tools - winget on one side,
                     Windows Update on the other - and a button whose meaning depends on
                     a tab is how someone installs the thing they were not looking at. -->
                <Grid>
                    <!-- Asking winget what is out of date is the dry run, and nothing is
                         ticked that winget did not install. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowingApps,
                                    Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Upgrade ticked" Style="{StaticResource GhostButton}"
                                Command="{Binding UpgradeTickedCommand}" Margin="0,0,8,0" />
                        <Button Content="Check" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CheckCommand}" />
                    </StackPanel>

                    <!-- Asking Windows Update what it has is the dry run. Installing
                         loads kernel code, and raises the one Administrator prompt. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowingDrivers,
                                    Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Install ticked" Style="{StaticResource GhostButton}"
                                Command="{Binding InstallDriversCommand}" Margin="0,0,8,0" />
                        <Button Content="Check drivers" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CheckDriversCommand}" />
                    </StackPanel>
                </Grid>
            </ctl:SectionFrame.Actions>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TabStrip}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Apps" GroupName="UpdaterTab"
                                     Style="{StaticResource TabPill}"
                                     IsChecked="{Binding ShowingApps}" />
                        <RadioButton Content="Drivers" GroupName="UpdaterTab"
                                     Style="{StaticResource TabPill}"
                                     IsChecked="{Binding ShowingDrivers}" />
                    </StackPanel>
                </Border>

                <!-- What the run is doing, line by line, while it does it.
                     Both tabs share this: the work they start is the same shape - a
                     download inside somebody else's tool, then an install - and only
                     one of them can be running. Present from the first press onwards,
                     including after it finished, because "what did it say" is asked
                     after the bar has gone as often as during. -->
                <!-- Capped, and the list keeps the rest. The log is evidence for what
                     the rows are saying, not the subject: the subject is which package
                     is on which version. -->
                <Border DockPanel.Dock="Bottom" Padding="15" Margin="0,14,0,0" MaxHeight="150">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- Nothing has been run yet, so there is nothing to
                                     report and no empty panel claiming otherwise. -->
                                <DataTrigger Binding="{Binding Activity.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Activity"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                        <ListBox x:Name="UpdaterLog" Style="{StaticResource PlainList}"
                                 ctl:AutoScroll.ToNewest="True"
                                 ItemsSource="{Binding Activity}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock x:Name="Mark" Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Margin="0,2,8,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap" MaxWidth="720"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="good">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE930;" />
                                            <Setter TargetName="Mark" Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="alert">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE814;" />
                                            <Setter TargetName="Mark" Property="Foreground"
                                                    Value="{DynamicResource DangerBrush}" />
                                            <Setter TargetName="Line" Property="Foreground"
                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Both bodies share one cell, so the hidden one costs no layout and
                     the visible one fills the frame rather than sitting at its own
                     natural width beside a gap. -->
                <Grid>

                <!-- ===== Apps ===== -->

                <DockPanel Visibility="{Binding ShowingApps,
                               Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}" Margin="0,0,0,16">
                    <ctl:Reading Value="{Binding PackageCount}" Caption="OUT OF DATE"
                                 Proportion="{Binding GaugePercent}" ShowProportion="True"
                                 Tint="{DynamicResource AccentUpdaterBrush}" Width="180" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Packages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetRow}" Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,13,0" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="300"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <!-- Upgrading one of these swaps a hand-placed
                                                         build for the store's. -->
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding NotFromWinget,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="not from winget"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Id}" FontSize="11.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Margin="14,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <Run Text="{Binding Installed, Mode=OneWay}" />
                                                <Run Text="&#x2192;" />
                                                <Run Text="{Binding Available, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}" />
                                            </TextBlock>

                                            <TextBlock Grid.Column="3" Text="{Binding Outcome}"
                                                       FontSize="11.5" Margin="14,0,0,0" MinWidth="76"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                </DockPanel>

                <!-- ===== Drivers ===== -->

                <DockPanel Visibility="{Binding ShowingDrivers,
                               Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource ReadingRow}"
                                Margin="0,0,0,16">
                        <ctl:Reading Value="{Binding DriverCount}" Caption="OUT OF DATE"
                                     Proportion="{Binding DriverGaugePercent}" ShowProportion="True"
                                     Tint="{DynamicResource AccentUpdaterBrush}" Width="180" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Drivers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InsetRow}" Padding="15,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" Margin="0,0,13,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Device}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="300"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Provider}" FontSize="11.5"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Margin="14,0,0,0" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="{Binding Installed, Mode=OneWay}" />
                                                        <Run Text="&#x2192;" />
                                                        <Run Text="{Binding Available, Mode=OneWay}"
                                                             Foreground="{DynamicResource AccentBrush}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="3" Text="{Binding Size}"
                                                               FontSize="11.5" Margin="14,0,0,0" MinWidth="58"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />

                                                    <TextBlock Grid.Column="4" Text="{Binding Outcome}"
                                                               FontSize="11.5" Margin="14,0,0,0" MinWidth="76"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Devices with no working driver, listed whether or not
                                     Windows Update has anything for them. Not tickable:
                                     what is left here is what this app cannot fix, and a
                                     tick box would promise otherwise. -->
                                <StackPanel Margin="15,14,15,4"
                                            Visibility="{Binding HasUndrivenDevices,
                                                Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="WINDOWS IS NOT DRIVING THESE"
                                               Style="{StaticResource GroupLabel}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="A driver above may cover one of these. Anything still listed after installing has no driver on Windows Update." />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding UndrivenDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InsetRow}" Padding="15,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="30,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="320"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding InstanceId}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="320"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding Problem}"
                                                               FontSize="11.5" Margin="14,0,0,0"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                </Grid>
            </DockPanel>
        </ctl:SectionFrame>
    </DataTemplate>

</ResourceDictionary>
