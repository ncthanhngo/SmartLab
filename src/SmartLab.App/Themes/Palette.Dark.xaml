<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Dark theme. Every key here has a twin in Palette.Light.xaml; the two files
        are swapped whole at runtime, so a key present in one and missing from the
        other is a crash waiting for whoever flips the switch.

        Depth comes from three closely spaced greys rather than from borders or
        shadows, which is what keeps a dark interface from looking like a stack of
        outlined boxes.

        Grey, like the light theme, rather than the violet this carried for a while.
        Two themes with different ideas of atmosphere read as two products. The blue
        bias in the greys is what stops a neutral dark reading as switched off, and
        it gives the coloured accents something to sit against instead of a void.
    -->

    <!-- The window is the big card, and this pair is its surface. -->
    <Color x:Key="ShellTopColor">#2A2E36</Color>
    <Color x:Key="ShellBottomColor">#161A20</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#20252D" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2A3038" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#181C23" />

    <!-- What the rail drops onto the card below it. Nearly black, since on a dark
         theme a shadow can only be read as an absence of the surface's light. -->
    <Color x:Key="CardShadowColor">#05070A</Color>

    <!-- The rail card. A lighter grey than the surface it is stacked on, so the two
         pieces separate by tone alone and neither needs a border to be found. -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#39404A" Offset="0" />
        <GradientStop Color="#30363F" Offset="0.5" />
        <GradientStop Color="#272C34" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandBlockBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3D6E" Offset="0" />
        <GradientStop Color="#1E2A4C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HairlineBrush" Color="#2E343D" />
    <SolidColorBrush x:Key="SidebarHairlineBrush" Color="#3F4650" />

    <!-- Hover fills. The rail has its own because it sits a shade lighter than the
         card below it, where the other one barely shows. -->
    <SolidColorBrush x:Key="HoverBrush" Color="#2B3139" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#3D4550" />

    <!-- ============================ the three pillars ============================

         Each is a filled orb roughly 130 px across, which is the largest coloured
         area in the product. They carry more saturation than anything else for that
         reason: at this size a muted fill reads as a disabled control.
    -->
    <Color x:Key="PillarCleanupTop">#5AB4FF</Color>
    <Color x:Key="PillarCleanupBottom">#2C6FD6</Color>

    <Color x:Key="PillarProtectionTop">#4FE3A8</Color>
    <Color x:Key="PillarProtectionBottom">#1E9E72</Color>

    <Color x:Key="PillarSpeedTop">#FF7BA8</Color>
    <Color x:Key="PillarSpeedBottom">#E23D77</Color>

    <SolidColorBrush x:Key="PillarCleanupBrush" Color="#5AB4FF" />
    <SolidColorBrush x:Key="PillarProtectionBrush" Color="#4FE3A8" />
    <SolidColorBrush x:Key="PillarSpeedBrush" Color="#FF7BA8" />

    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#6B7887" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2B3644" />

    <LinearGradientBrush x:Key="LogoPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E2A22" Offset="0" />
        <GradientStop Color="#16202A" Offset="1" />
    </LinearGradientBrush>

    <!-- Lifted well clear of the surfaces below. The greys these replaced sat near
         3:1, which is not a colour a caption can be read in. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BFC6D0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#98A1AD" />

    <!-- The rail has its own pair. It sits a shade lighter than the card below it,
         where the brushes above lose most of their separation. -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#C3CAD4" />

    <!-- Accent taken from the EVSELab mark, so the brand reads as the app's. -->
    <Color x:Key="AccentColor">#2BD673</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2BD673" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#22B25E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B3A29" />

    <!-- Sits on a saturated accent plate, so it has to be dark rather than light. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1018" />

    <Color x:Key="BoltColor">#F5B93B</Color>
    <SolidColorBrush x:Key="BoltBrush" Color="#F5B93B" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F5B93B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5AA9FF" />

    <!-- Large filled areas, not text: a gauge ring can hold more saturation than a
         caption can, so these stay brighter than the semantic brushes above. -->
    <SolidColorBrush x:Key="AccentDeletedBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="AccentCleanupBrush" Color="#F5B93B" />
    <SolidColorBrush x:Key="AccentUninstallBrush" Color="#FF6B8A" />
    <SolidColorBrush x:Key="AccentAboutBrush" Color="#4DD4C4" />
    <SolidColorBrush x:Key="AccentTrashBrush" Color="#D9A441" />
    <SolidColorBrush x:Key="AccentSpaceLensBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="AccentLargeBrush" Color="#63B3ED" />
    <SolidColorBrush x:Key="AccentShredderBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="AccentUpdaterBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="AccentOptimizeBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="AccentMaintenanceBrush" Color="#8B9DF7" />
    <SolidColorBrush x:Key="AccentMalwareBrush" Color="#FF8A5B" />
    <SolidColorBrush x:Key="AccentSmartBrush" Color="#7DD3FC" />

    <!-- The unfilled part of a gauge ring. Bright enough to show the ring's shape
         on a dark card, dim enough that an empty gauge does not read as a value. -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#232D3E" />

    <!-- Per-section accents, read by the navigation rail. Strings rather than
         brushes: the rail builds its own at whatever opacity each part needs. -->
    <sys:String x:Key="NavSmartHex">#7DD3FC</sys:String>

    <sys:String x:Key="NavCleanupHex">#F5B93B</sys:String>
    <sys:String x:Key="NavTrashHex">#D9A441</sys:String>

    <sys:String x:Key="NavRepairHex">#2BD673</sys:String>
    <sys:String x:Key="NavMalwareHex">#FF8A5B</sys:String>

    <sys:String x:Key="NavOptimizeHex">#A78BFA</sys:String>
    <sys:String x:Key="NavMaintenanceHex">#8B9DF7</sys:String>

    <sys:String x:Key="NavUninstallHex">#FF6B8A</sys:String>
    <sys:String x:Key="NavUpdaterHex">#F472B6</sys:String>

    <sys:String x:Key="NavSpaceLensHex">#5AA9FF</sys:String>
    <sys:String x:Key="NavLargeHex">#63B3ED</sys:String>
    <sys:String x:Key="NavDeletedHex">#4DC4E8</sys:String>
    <sys:String x:Key="NavShredderHex">#FF6B6B</sys:String>

    <sys:String x:Key="NavSettingsHex">#94A3B8</sys:String>
    <sys:String x:Key="NavAboutHex">#4DD4C4</sys:String>

</ResourceDictionary>
