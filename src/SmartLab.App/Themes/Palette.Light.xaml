<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Light theme. Same keys as Palette.Dark.xaml, chosen rather than inverted.
        Two rules did most of the work here:

        The greens, ambers and blues that read well on a dark ground are far too
        pale on a white one. Anything that carries text or a thin glyph is darkened
        until it holds its own against white; anything that is a large filled area,
        like a gauge ring, keeps its saturation because area supplies the contrast
        that a caption cannot.

        The ground is not white. A blue bias in the greys echoes the dark theme's
        blue-black and stops the surfaces reading as bare paper.
    -->

    <!-- The same violet, held far back. On a light ground the atmosphere has to be a
         tint rather than a colour, or every surface laid on it loses its edges. -->
    <Color x:Key="ShellTopColor">#E7DEFB</Color>
    <Color x:Key="ShellBottomColor">#D4C7F2</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F7F4FE" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#EFEAFA" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#DBCEF7" Offset="0" />
        <GradientStop Color="#CFC0F1" Offset="0.5" />
        <GradientStop Color="#C2B1EB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandBlockBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCE5F7" Offset="0" />
        <GradientStop Color="#CCD8EE" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HairlineBrush" Color="#DFD7F0" />
    <SolidColorBrush x:Key="SidebarHairlineBrush" Color="#B4A2E2" />

    <SolidColorBrush x:Key="HoverBrush" Color="#EAE3F9" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#B9A6E8" />

    <!-- ============================ the three pillars ============================
         Kept saturated. These are large filled areas, where area supplies the
         contrast a caption would need from darkness. -->
    <Color x:Key="PillarCleanupTop">#4FA8F5</Color>
    <Color x:Key="PillarCleanupBottom">#2360C4</Color>

    <Color x:Key="PillarProtectionTop">#3ED397</Color>
    <Color x:Key="PillarProtectionBottom">#128B62</Color>

    <Color x:Key="PillarSpeedTop">#FF6E9E</Color>
    <Color x:Key="PillarSpeedBottom">#D42E68</Color>

    <SolidColorBrush x:Key="PillarCleanupBrush" Color="#2360C4" />
    <SolidColorBrush x:Key="PillarProtectionBrush" Color="#128B62" />
    <SolidColorBrush x:Key="PillarSpeedBrush" Color="#D42E68" />

    <!-- White, not grey: on light the toggle track is already pale, so an off knob
         has to be lighter than its track rather than darker. -->
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C0CAD9" />

    <LinearGradientBrush x:Key="LogoPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E7F3EB" Offset="0" />
        <GradientStop Color="#DFE8F2" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#131A25" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5A6B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#78859A" />

    <!-- The EVSELab green at #2BD673 sits at about 1.7:1 on white, which is not a
         colour so much as a suggestion of one. Darkened until it can carry a label. -->
    <Color x:Key="AccentColor">#0E9E56</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E9E56" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0A7B42" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCF2E6" />

    <!-- Flipped: on light the accent plate is the dark element, so its text is white. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <Color x:Key="BoltColor">#D8930A</Color>
    <SolidColorBrush x:Key="BoltBrush" Color="#D8930A" />

    <SolidColorBrush x:Key="WarningBrush" Color="#A96A05" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62B2B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1F5FBF" />

    <!-- Large filled areas, so these stay more saturated than the text brushes. -->
    <SolidColorBrush x:Key="AccentDeletedBrush" Color="#2E7FE0" />
    <SolidColorBrush x:Key="AccentCleanupBrush" Color="#E09A0C" />
    <SolidColorBrush x:Key="AccentUninstallBrush" Color="#D8446A" />
    <SolidColorBrush x:Key="AccentAboutBrush" Color="#0F9086" />
    <SolidColorBrush x:Key="AccentTrashBrush" Color="#C4901F" />
    <SolidColorBrush x:Key="AccentMailBrush" Color="#D18B14" />
    <SolidColorBrush x:Key="AccentSpaceLensBrush" Color="#2E7FE0" />
    <SolidColorBrush x:Key="AccentLargeBrush" Color="#2A72C4" />
    <SolidColorBrush x:Key="AccentShredderBrush" Color="#C62B2B" />
    <SolidColorBrush x:Key="AccentUpdaterBrush" Color="#BE3A80" />
    <SolidColorBrush x:Key="AccentExtensionsBrush" Color="#A93A96" />
    <SolidColorBrush x:Key="AccentOptimizeBrush" Color="#6B4FD0" />
    <SolidColorBrush x:Key="AccentMaintenanceBrush" Color="#4A5AC4" />
    <SolidColorBrush x:Key="AccentMalwareBrush" Color="#C2500F" />
    <SolidColorBrush x:Key="AccentSmartBrush" Color="#0E7490" />

    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#DFE6F1" />

    <!-- Darkened for the same reason the accent was: these draw 17px glyphs on a
         tinted rail, and a glyph is a thin mark before it is a colour. -->
    <sys:String x:Key="NavSmartHex">#0E7490</sys:String>

    <sys:String x:Key="NavCleanupHex">#B3760A</sys:String>
    <sys:String x:Key="NavMailHex">#A56A08</sys:String>
    <sys:String x:Key="NavTrashHex">#96610C</sys:String>

    <sys:String x:Key="NavRepairHex">#0E9E56</sys:String>
    <sys:String x:Key="NavMalwareHex">#C2500F</sys:String>

    <sys:String x:Key="NavOptimizeHex">#6B4FD0</sys:String>
    <sys:String x:Key="NavMaintenanceHex">#4A5AC4</sys:String>

    <sys:String x:Key="NavUninstallHex">#C93A5E</sys:String>
    <sys:String x:Key="NavUpdaterHex">#BE3A80</sys:String>
    <sys:String x:Key="NavExtensionsHex">#A93A96</sys:String>

    <sys:String x:Key="NavSpaceLensHex">#2166CC</sys:String>
    <sys:String x:Key="NavLargeHex">#1F6BB0</sys:String>
    <sys:String x:Key="NavDeletedHex">#0E7C99</sys:String>
    <sys:String x:Key="NavShredderHex">#C62B2B</sys:String>

    <sys:String x:Key="NavSettingsHex">#526075</sys:String>
    <sys:String x:Key="NavAboutHex">#0C8078</sys:String>

</ResourceDictionary>
