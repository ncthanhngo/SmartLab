<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The EVSELab mark, redrawn as vector geometry rather than shipped as a
        bitmap. Three reasons: the black background of the original is simply
        absent instead of needing to be keyed out, the mark stays sharp at tray
        size and at title size from one definition, and the app carries no binary
        asset that has to travel with the single-file executable.

        Drawn in a 24x24 box so it composes with the icon geometry elsewhere.
    -->
    <PathGeometry x:Key="BoltGeometry"
                  Figures="M 13.5,1.5 L 4,14 L 10.5,14 L 9,22.5 L 19,9.5 L 12.5,9.5 Z" />

    <!-- The full wordmark: EVSE in the brand green, Lab in white, then the bolt. -->
    <ControlTemplate x:Key="LogoLockupTemplate" TargetType="Control">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- The two Runs must stay on one line. XAML preserves the whitespace
                 between inline elements, so splitting them across lines renders
                 "EVSE Lab" where the mark reads "EVSELab". -->
            <TextBlock VerticalAlignment="Center"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="17" FontWeight="Bold"><Run
                       Text="EVSE" Foreground="{DynamicResource AccentBrush}" /><Run
                       Text="Lab" Foreground="{DynamicResource TextPrimaryBrush}" /></TextBlock>

            <Path Data="{StaticResource BoltGeometry}"
                  Fill="{DynamicResource BoltBrush}"
                  Stretch="Uniform" Width="15" Height="15"
                  Margin="7,0,0,1" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <Style x:Key="LogoLockup" TargetType="Control">
        <Setter Property="Template" Value="{StaticResource LogoLockupTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- The bolt alone on a soft plate, for places that need a square glyph. -->
    <ControlTemplate x:Key="LogoMarkTemplate" TargetType="Control">
        <Border CornerRadius="9" Width="34" Height="34"
                Background="{DynamicResource LogoPlateBrush}">
            <Path Data="{StaticResource BoltGeometry}"
                  Fill="{DynamicResource BoltBrush}"
                  Stretch="Uniform" Width="17" Height="17"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>

    <Style x:Key="LogoMark" TargetType="Control">
        <Setter Property="Template" Value="{StaticResource LogoMarkTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

</ResourceDictionary>
